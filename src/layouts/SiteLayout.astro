---
// 공용 사이트 레이아웃 — 프로필 홈(/)과 포트폴리오(/portfolio/)가 함께 쓴다.
// 헤더 내비게이션, 테마 토글, 전역 스타일을 한 곳에 모아서 페이지마다
// 중복하지 않도록 했다.
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  path: string;
  active: 'profile' | 'portfolio';
  ogImageAlt?: string;
}

const { title, description, path, active, ogImageAlt } = Astro.props;
const SITE = 'https://linux-edu.vercel.app';
const NAME = '최경성';
---
<!doctype html>
<html lang="ko" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={SITE + path} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={NAME} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={SITE + path} />
  <meta property="og:image" content={SITE + '/og.png'} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt ?? description} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={SITE + '/og.png'} />
</head>
<body>
  <header class="mast">
    <div class="mast__in">
      <a href="/" class="mast__name">{NAME}</a>
      <nav class="mast__nav">
        <a href="/" aria-current={active === 'profile' ? 'page' : undefined}>프로필</a>
        <a href="/portfolio/" aria-current={active === 'portfolio' ? 'page' : undefined}>포트폴리오</a>
        <button id="theme" type="button" class="tbtn">테마</button>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap">© {new Date().getFullYear()} {NAME}</div>
  </footer>

  <script>
    const root = document.documentElement;
    try {
      const saved = localStorage.getItem('pf-theme');
      if (saved === 'dark' || saved === 'light') root.setAttribute('data-theme', saved);
      else if (window.matchMedia('(prefers-color-scheme: dark)').matches) root.setAttribute('data-theme', 'dark');
    } catch (e) {}
    document.getElementById('theme')?.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('pf-theme', next); } catch (e) {}
    });
  </script>

  <style is:global>
    *{box-sizing:border-box}
    body{
      margin:0; background:var(--ground); color:var(--ink);
      font-family:var(--sans); font-size:17px; line-height:1.85;
      -webkit-font-smoothing:antialiased;
    }
    .wrap{max-width:1080px; margin:0 auto; padding:0 28px}
    a{color:inherit}
    :focus-visible{outline:2px solid var(--accent); outline-offset:3px; border-radius:4px}

    .mast{border-bottom:1px solid var(--rule); position:sticky; top:0; background:var(--ground); z-index:10}
    .mast__in{
      max-width:1080px; margin:0 auto; padding:18px 28px;
      display:flex; align-items:center; justify-content:space-between; gap:20px;
    }
    .mast__name{font-weight:700; letter-spacing:-.01em; text-decoration:none}
    .mast__nav{display:flex; align-items:center; gap:20px; font-size:.88rem}
    .mast__nav a{color:var(--ink2); text-decoration:none}
    .mast__nav a:hover{color:var(--accent)}
    .mast__nav a[aria-current="page"]{color:var(--accent); font-weight:600}
    .tbtn{
      font-family:var(--mono); font-size:.7rem; letter-spacing:.08em; color:var(--ink2);
      background:var(--surface2); border:1px solid var(--rule); border-radius:999px;
      padding:5px 13px; cursor:pointer;
    }
    .tbtn:hover{border-color:var(--rule2); color:var(--ink)}

    .hero{padding:76px 0 56px; max-width:62ch}
    .hero__k{
      font-family:var(--mono); font-size:.72rem; font-weight:600; letter-spacing:.16em;
      text-transform:uppercase; color:var(--accent); margin:0 0 16px;
    }
    .hero h1{
      font-family:var(--serif); font-size:clamp(2.2rem,5.5vw,3.4rem); line-height:1.22; font-weight:400;
      letter-spacing:-.01em; margin:0 0 22px; text-wrap:balance;
    }
    .hero__lead{
      font-family:var(--serif); font-size:1.12rem; line-height:1.9;
      color:var(--ink2); margin:0; border-left:2px solid var(--plum); padding-left:20px;
    }

    .cards{display:grid; grid-template-columns:repeat(2,1fr); gap:20px; padding-bottom:80px}
    .cards--solo{grid-template-columns:1fr}
    .card{
      display:block; text-decoration:none; background:var(--surface);
      border:1px solid var(--rule); border-radius:16px; padding:28px 30px 26px;
      box-shadow:var(--shadow);
      transition:border-color .18s, transform .18s, box-shadow .18s;
    }
    .card:hover{border-color:var(--accent-line); transform:translateY(-3px)}
    .card__top{display:flex; align-items:center; justify-content:space-between; gap:14px; margin-bottom:14px}
    .card__kind{
      font-family:var(--mono); font-size:.66rem; letter-spacing:.14em;
      text-transform:uppercase; color:var(--ink3);
    }
    .chip{
      font-size:.72rem; padding:3px 11px; border-radius:999px;
      background:var(--accent-soft); color:var(--accent); font-weight:600; white-space:nowrap;
    }
    .chip--done{background:var(--ok-soft); color:var(--ok)}
    .card__t{font-size:1.32rem; font-weight:700; letter-spacing:-.015em; margin:0 0 12px; line-height:1.4}
    .card__s{font-size:.94rem; color:var(--ink2); margin:0 0 20px; max-width:60ch}
    .prog{display:flex; align-items:center; gap:13px; margin-bottom:18px}
    .prog__bar{flex:1; height:3px; background:var(--surface3); border-radius:2px; overflow:hidden; max-width:220px}
    .prog__fill{height:100%; background:var(--accent)}
    .prog__n{
      font-family:var(--mono); font-size:.72rem; color:var(--ink3);
      font-variant-numeric:tabular-nums; white-space:nowrap;
    }
    .tags{display:flex; flex-wrap:wrap; gap:8px; list-style:none; margin:0; padding:0}
    .tags li{
      font-size:.75rem; color:var(--ink2); background:var(--surface2);
      border:1px solid var(--rule); border-radius:6px; padding:2px 9px;
    }

    .foot{border-top:1px solid var(--rule); padding:26px 0; font-size:.82rem; color:var(--ink3)}

    /* ── 프로필 페이지 전용 ───────────────────────────────── */
    .profile-head{padding:76px 0 48px; display:flex; gap:32px; align-items:flex-start; flex-wrap:wrap}
    .avatar{
      width:104px; height:104px; border-radius:50%; flex:none;
      background:linear-gradient(155deg,var(--accent-soft),var(--plum-soft));
      border:1px solid var(--rule); display:flex; align-items:center; justify-content:center;
      font-family:var(--serif); font-size:2.4rem; color:var(--accent);
    }
    .profile-head__text{flex:1; min-width:260px}
    .profile-head h1{
      font-family:var(--serif); font-weight:400; font-size:clamp(2rem,4.5vw,2.9rem);
      margin:0 0 6px; letter-spacing:-.01em;
    }
    .profile-head__role{
      font-size:1rem; color:var(--ink2); margin:0 0 18px;
    }
    .profile-head__bio{
      font-family:var(--serif); font-size:1.05rem; line-height:1.9; color:var(--ink2);
      max-width:62ch; margin:0;
    }

    .section{padding:0 0 56px}
    .section__h{
      font-size:1rem; font-weight:700; letter-spacing:-.01em; margin:0 0 20px;
      display:flex; align-items:center; gap:10px;
    }
    .section__h::after{content:""; flex:1; height:1px; background:var(--rule)}

    .timeline{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:22px}
    .timeline li{
      display:grid; grid-template-columns:120px 1fr; gap:20px; align-items:baseline;
    }
    .timeline .tl__when{
      font-family:var(--mono); font-size:.78rem; color:var(--ink3);
      font-variant-numeric:tabular-nums; white-space:nowrap;
    }
    .timeline .tl__what{margin:0}
    .timeline .tl__org{font-weight:600; margin:0 0 3px}
    .timeline .tl__desc{margin:0; color:var(--ink2); font-size:.94rem; max-width:58ch}

    .example-note{
      font-size:.82rem; color:var(--ink3); background:var(--surface2);
      border:1px dashed var(--rule2); border-radius:10px; padding:10px 16px; margin:0 0 40px;
    }

    .contact-list{list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:14px}
    .contact-list a{
      display:inline-flex; align-items:center; gap:8px; font-size:.9rem;
      background:var(--surface); border:1px solid var(--rule); border-radius:10px;
      padding:10px 16px; text-decoration:none; box-shadow:var(--shadow);
      transition:border-color .18s, transform .18s;
    }
    .contact-list a:hover{border-color:var(--accent-line); transform:translateY(-2px); color:var(--accent)}
    .contact-list .k{
      font-family:var(--mono); font-size:.68rem; letter-spacing:.1em; text-transform:uppercase;
      color:var(--ink3);
    }

    @media (max-width:820px){
      .cards{grid-template-columns:1fr}
      .hero{padding:52px 0 40px}
      .profile-head{padding:52px 0 40px}
      .timeline li{grid-template-columns:1fr; gap:4px}
      .wrap,.mast__in{padding-left:20px; padding-right:20px}
      body{font-size:16px}
    }
    @media (prefers-reduced-motion:reduce){*{transition:none!important}}
  </style>
</body>
</html>
