---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data/projects';
import TagFilter from '../../components/TagFilter.astro';

const items = projects.filter((p) => p.section === 'library');
const tags = [...new Set(items.flatMap((p) => p.tags))];
const idx = (p: (typeof items)[number]) => p.tags.map((t) => tags.indexOf(t)).join(' ');
---
<SiteLayout title="자료실 · 최경성" description="계속 쌓이는 자료: 기사 브리핑, AI 활용 TIP 등." path="/library/" active="library">
  <div class="wrap">
    <header class="ph">
      <h1 class="ph__h">자료실</h1>
      <p class="ph__p">계속 쌓이는 자료를 모아 둡니다. 기사 브리핑과 AI 활용 TIP이 있습니다.</p>
    </header>
    <TagFilter tags={tags} />
    <section class="rows" aria-label="자료 목록">
      {items.map((p) => (
        <a class="row" data-tags={idx(p)} href={p.href} target={p.newWindow ? '_blank' : undefined} rel={p.newWindow ? 'noopener' : undefined}>
          <div>
            <p class="row__meta">{p.kind} · <span class="st">{p.status}</span></p>
            <h2 class="row__t">{p.title}</h2>
          </div>
          <div>
            <p class="row__s">{p.summary}</p>
            <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
            <span class="row__go" aria-hidden="true">열어 보기 →</span>
          </div>
        </a>
      ))}
    </section>
  </div>
</SiteLayout>
