---
import SiteLayout from '../layouts/SiteLayout.astro';

const TITLE = '최경성 · 프로필';
const DESC = '교육 콘텐츠 기획자 · 기술 문서 작성자. 학습자의 눈높이에서 시작해, 왜 그렇게 설계됐는지부터 설명하는 자료를 만듭니다.';

// 아래 경력·학력·연락처는 전부 예시(placeholder) 자료입니다.
// 실제 정보로 바꿔서 채워 넣으세요 — src/pages/index.astro 에서 직접 수정하면 됩니다.
const skills = [
  '교육과정 설계', '기술 문서 작성', 'Linux · 서버 운영', '정보보안 교육',
  '웹 퍼블리싱(Astro)', '콘텐츠 기획',
];

const experience = [
  {
    when: '2023 — 현재',
    org: '○○ 교육기관 · 콘텐츠 기획팀',
    desc: '초심자를 위한 IT 교육 커리큘럼을 설계하고, 실습 중심 학습 자료를 제작합니다.',
  },
  {
    when: '2020 — 2023',
    org: '○○ 회사 · 기술문서팀',
    desc: '제품 사용자 가이드와 사내 운영 매뉴얼을 작성하고, 문서 템플릿 체계를 정리했습니다.',
  },
  {
    when: '2018 — 2020',
    org: '○○ 회사 · 주니어 기획자',
    desc: '서비스 기획과 콘텐츠 편집 업무를 담당했습니다.',
  },
];

const education = [
  { when: '2014 — 2018', what: '○○대학교 ○○학과 졸업' },
];

const contacts = [
  { k: 'Email', label: 'example@email.com', href: 'mailto:example@email.com' },
  { k: 'GitHub', label: 'github.com/username', href: 'https://github.com/' },
  { k: 'LinkedIn', label: 'linkedin.com/in/username', href: 'https://linkedin.com/' },
];
---
<SiteLayout title={TITLE} description={DESC} path="/" active="profile">
  <section class="profile-head">
    <img class="avatar" src="/avatar.png" alt="최경성" width="104" height="104" />
    <div class="profile-head__text">
      <h1>최경성</h1>
      <p class="profile-head__role">교육 콘텐츠 기획자 · 기술 문서 작성자</p>
      <p class="profile-head__bio">
        학습자의 눈높이에서 시작해, <em>왜 그렇게 설계됐는지</em>부터 설명하는 자료를 만듭니다.
        처음 접하는 사람도 혼자 힘으로 이해할 수 있는 문서와 커리큘럼을 지향합니다.
      </p>
    </div>
  </section>

  <p class="example-note">
    이 프로필 페이지는 예시(placeholder) 자료로 채워져 있습니다. 경력·학력·연락처를 실제 정보로 바꿔주세요.
  </p>

  <section class="section">
    <h2 class="section__h">기술 · 관심 분야</h2>
    <ul class="tags">{skills.map((s) => <li>{s}</li>)}</ul>
  </section>

  <section class="section">
    <h2 class="section__h">경력</h2>
    <ul class="timeline">
      {experience.map((e) => (
        <li>
          <span class="tl__when">{e.when}</span>
          <div class="tl__what">
            <p class="tl__org">{e.org}</p>
            <p class="tl__desc">{e.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="section__h">학력</h2>
    <ul class="timeline">
      {education.map((e) => (
        <li>
          <span class="tl__when">{e.when}</span>
          <div class="tl__what"><p class="tl__org">{e.what}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="section__h">연락처</h2>
    <ul class="contact-list">
      {contacts.map((c) => (
        <li>
          <a href={c.href}>
            <span class="k">{c.k}</span>
            <span>{c.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
