---
import SiteLayout from '../layouts/SiteLayout.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
import Mascot from '../components/Mascot.astro';

const TITLE = '최경성 · 교육 콘텐츠 기획자';
const DESC = '교육 콘텐츠 기획자 · 기술 문서 작성자. 학습자의 눈높이에서 시작해, 왜 그렇게 설계됐는지부터 설명하는 자료를 만듭니다.';

// 아래 경력·학력·연락처는 전부 예시(placeholder) 자료입니다.
// 실제 정보로 바꿔서 채워 넣으세요 — src/pages/index.astro 에서 직접 수정하면 됩니다.
const skills = [
  '교육과정 설계', '기술 문서 작성', 'Linux · 서버 운영', '정보보안 교육',
  '웹 퍼블리싱(Astro)', '콘텐츠 기획',
];

const experience = [
  {
    when: '2023 — 현재',
    org: '○○ 교육기관 · 콘텐츠 기획팀',
    desc: '초심자를 위한 IT 교육 커리큘럼을 설계하고, 실습 중심 학습 자료를 제작합니다.',
  },
  {
    when: '2020 — 2023',
    org: '○○ 회사 · 기술문서팀',
    desc: '제품 사용자 가이드와 사내 운영 매뉴얼을 작성하고, 문서 템플릿 체계를 정리했습니다.',
  },
  {
    when: '2018 — 2020',
    org: '○○ 회사 · 주니어 기획자',
    desc: '서비스 기획과 콘텐츠 편집 업무를 담당했습니다.',
  },
];

const education = [
  { when: '2014 — 2018', what: '○○대학교 ○○학과 졸업' },
];

const contacts = [
  { k: 'Email', label: 'example@email.com', href: 'mailto:example@email.com' },
  { k: 'GitHub', label: 'github.com/username', href: 'https://github.com/' },
  { k: 'LinkedIn', label: 'linkedin.com/in/username', href: 'https://linkedin.com/' },
];

const portfolio = projects.filter((p) => p.section === 'portfolio');
const library = projects.filter((p) => p.section === 'library');

const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<SiteLayout title={TITLE} description={DESC} path="/" active="home" bleed>
    <section class="hero col">
      <div class="hero__text">
        <h1 class="hero__h">혼자서도 이해되는 자료를 만듭니다</h1>
        <p class="hero__p">
          교육 콘텐츠 기획자 · 기술 문서 작성자 최경성입니다. 학습자의 눈높이에서 시작해,
          왜 그렇게 설계됐는지부터 설명하는 교재와 문서를 만듭니다.
        </p>
      </div>
      <Mascot />
    </section>

    <section class="sec sec--b" id="blog" aria-labelledby="blog-h"><div class="col">
      <h2 id="blog-h" class="sec__h">블로그</h2>
      {posts.length === 0 ? (
        <p class="empty">첫 글을 준비하고 있습니다.</p>
      ) : (
        <ul class="list">
          {posts.map((p) => (
            <li>
              <a class="item" href={`/blog/${p.id}/`} target="_blank" rel="noopener">
                <span class="item__top"><span class="item__t">{p.data.title}</span><span class="item__m">{fmt(p.data.date)}</span></span>
                <span class="item__s">{p.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div></section>

    <section class="sec sec--a" id="portfolio" aria-labelledby="portfolio-h"><div class="col">
      <h2 id="portfolio-h" class="sec__h">포트폴리오</h2>
      <ul class="list">
        {portfolio.map((p) => (
          <li>
            <a class="item" href={p.href} target="_blank" rel="noopener">
              <span class="item__top"><span class="item__t">{p.title}</span><span class="item__m">{p.kind} · {p.status}</span></span>
              <span class="item__s">{p.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </div></section>

    <section class="sec sec--b" id="library" aria-labelledby="library-h"><div class="col">
      <h2 id="library-h" class="sec__h">자료실</h2>
      <ul class="list">
        {library.map((p) => (
          <li>
            <a class="item" href={p.href} target={p.newWindow ? '_blank' : undefined} rel={p.newWindow ? 'noopener' : undefined}>
              <span class="item__top"><span class="item__t">{p.title}</span><span class="item__m">{p.kind} · {p.status}</span></span>
              <span class="item__s">{p.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </div></section>

    <section class="sec sec--a" id="about" aria-labelledby="about-h"><div class="col">
      <h2 id="about-h" class="sec__h">소개</h2>
      <div class="about">
        <p>교육 콘텐츠를 기획하고 기술 문서를 씁니다. 처음 접하는 사람도 혼자 힘으로 이해할 수 있는 문서와 커리큘럼이 목표입니다.</p>
        <dl class="cv">
          {experience.map((e) => (<><dt>{e.when}</dt><dd>{e.org}</dd></>))}
          {education.map((e) => (<><dt>{e.when}</dt><dd>{e.what}</dd></>))}
        </dl>
        <p class="about__skills">{skills.join(' · ')}</p>
        <p class="about__note">경력·학력·연락처는 예시 자료입니다. 실제 정보로 바꿔 주세요.</p>
      </div>
    </div></section>

    <section class="sec sec--b" id="contact" aria-labelledby="contact-h"><div class="col">
      <h2 id="contact-h" class="sec__h">연락처</h2>
      <ul class="contacts">
        {contacts.map((c) => (
          <li><span>{c.k}</span><a href={c.href}>{c.label}</a></li>
        ))}
      </ul>
    </div></section>
</SiteLayout>

<style is:global>
  .hero{padding-block:88px 24px; display:grid; grid-template-columns:1fr auto; gap:24px; align-items:center}
  .hero .hero__h{font-size:clamp(2.2rem,6vw,3.6rem); font-weight:700; letter-spacing:-.035em; line-height:1.18; margin-bottom:24px}
  .hero .hero__p{font-size:1.15rem; color:var(--ink2); max-width:40ch}

  .about{display:flex; flex-direction:column; gap:20px;
    p{max-width:44ch}
  }
  .cv{display:grid; grid-template-columns:120px 1fr; gap:6px 16px; font-variant-numeric:tabular-nums;
    dt{color:var(--ink3); font-size:.92rem}
    dd{margin:0}
  }
  .about .about__skills{color:var(--ink2)}
  .about .about__note{color:var(--ink3); font-size:.9rem}

  .contacts{list-style:none; display:flex; flex-direction:column; gap:6px;
    li{display:grid; grid-template-columns:120px 1fr; gap:16px}
    li span{color:var(--ink3)}
    a{color:var(--ink); text-decoration:underline; text-underline-offset:4px; text-decoration-color:var(--ink3); &:hover{text-decoration-color:var(--ink)}}
  }

  @media (max-width:600px){
    .hero{padding-top:40px; grid-template-columns:1fr}
    .hero .mascot{order:-1; justify-self:start; width:min(100%,300px)}
    .cv,.contacts li{grid-template-columns:1fr; gap:0}
    .cv dd{margin-bottom:10px}
  }
</style>
