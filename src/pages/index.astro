---
import SiteLayout from '../layouts/SiteLayout.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

const TITLE = '최경성 · 교육 콘텐츠 기획자';
const DESC = '교육 콘텐츠 기획자 · 기술 문서 작성자. 학습자의 눈높이에서 시작해, 왜 그렇게 설계됐는지부터 설명하는 자료를 만듭니다.';

// 아래 경력·학력·연락처는 전부 예시(placeholder) 자료입니다.
// 실제 정보로 바꿔서 채워 넣으세요 — src/pages/index.astro 에서 직접 수정하면 됩니다.
const skills = [
  '교육과정 설계', '기술 문서 작성', 'Linux · 서버 운영', '정보보안 교육',
  '웹 퍼블리싱(Astro)', '콘텐츠 기획',
];

const experience = [
  {
    when: '2023 — 현재',
    org: '○○ 교육기관 · 콘텐츠 기획팀',
    desc: '초심자를 위한 IT 교육 커리큘럼을 설계하고, 실습 중심 학습 자료를 제작합니다.',
  },
  {
    when: '2020 — 2023',
    org: '○○ 회사 · 기술문서팀',
    desc: '제품 사용자 가이드와 사내 운영 매뉴얼을 작성하고, 문서 템플릿 체계를 정리했습니다.',
  },
  {
    when: '2018 — 2020',
    org: '○○ 회사 · 주니어 기획자',
    desc: '서비스 기획과 콘텐츠 편집 업무를 담당했습니다.',
  },
];

const education = [
  { when: '2014 — 2018', what: '○○대학교 ○○학과 졸업' },
];

const contacts = [
  { k: 'Email', label: 'example@email.com', href: 'mailto:example@email.com' },
  { k: 'GitHub', label: 'github.com/username', href: 'https://github.com/' },
  { k: 'LinkedIn', label: 'linkedin.com/in/username', href: 'https://linkedin.com/' },
];

const portfolio = projects.filter((p) => p.section === 'portfolio');
const library = projects.filter((p) => p.section === 'library');
const shotOf: Record<string, string> = { linux: '/img/work-linux.jpg', econ: '/img/work-econ.jpg', press: '/img/work-press.jpg', 'ai-tips': '/img/work-aitips.jpg' };
const altOf: Record<string, string> = {
  linux: '리눅스 입문 교재의 첫 화면',
  econ: '경제 기초 교재의 첫 화면',
  press: '신문 형태로 정리한 기사 브리핑',
  'ai-tips': 'AI 활용 TIP 페이지',
};

const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 12);
const fmt = (d: Date) => d.toISOString().slice(0, 10);

const folders = [
  { name: '포트폴리오', href: '#portfolio' },
  { name: '자료실', href: '#library' },
  { name: '블로그', href: '#blog' },
  { name: '연락처', href: '#contact' },
];
---
<SiteLayout title={TITLE} description={DESC} path="/" active="home" bleed>
  <section class="hero">
    <h1 class="hero__h">혼자서도 이해되는 자료</h1>
    <p class="hero__p">교육 콘텐츠 기획자 · 기술 문서 작성자 최경성. 왜 그렇게 설계됐는지부터 설명하는 교재와 문서를 만듭니다.</p>
    <div class="fstack" aria-label="구역 바로가기">
      {folders.map((f, i) => (
        <a class={`fd fd--${i + 1}`} href={f.href}>
          <span class="fd__tab">{f.name}</span>
          {i === folders.length - 1 && <span class="btn fd__btn">연락하기</span>}
        </a>
      ))}
    </div>
  </section>

  <section class="sec" id="portfolio" aria-labelledby="portfolio-h">
    <div class="sec__head">
      <h2 id="portfolio-h" class="sec__h">포트폴리오</h2>
    </div>
    <div class="bands">
      {portfolio.map((p, i) => (
        <article class={`band band--${i + 1}`} style={`--i:${i}`}>
          <span class="band__tab">{p.title}</span>
          <div class="band__strip"><span>{p.kind}</span></div>
          <div class="band__in">
            <img class="band__img" src={shotOf[p.slug]} alt={altOf[p.slug]} width="1600" height="1000" loading="lazy" />
            <div class="band__txt">
              <p class="st">{p.status}</p>
              <p class="band__s">{p.summary}</p>
              {p.progress && <p class="band__n">{p.progress.done} / {p.progress.total}개 챕터 공개</p>}
              <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
              <a class="btn" href={p.href}>열어 보기</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="sec" id="library" aria-labelledby="library-h">
    <div class="sec__head">
      <h2 id="library-h" class="sec__h">자료실</h2>
    </div>
    <div class="lib">
      {library.map((p) => (
        <a class="lib__item rv" href={p.href} target={p.newWindow ? '_blank' : undefined} rel={p.newWindow ? 'noopener' : undefined}>
          <img src={shotOf[p.slug]} alt={altOf[p.slug]} width="1600" height="1000" loading="lazy" />
          <p class="lib__meta">{p.kind} · <span class="st">{p.status}</span></p>
          <h3 class="lib__t">{p.title}</h3>
          <p class="lib__s">{p.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="sec" id="blog" aria-labelledby="blog-h">
    <div class="sec__head">
      <h2 id="blog-h" class="sec__h">블로그</h2>
    </div>
    {posts.length === 0 ? (
      <p class="empty">첫 글을 준비하고 있습니다.</p>
    ) : (
      <div class="rows">
        {posts.map((p) => (
          <a class="row" href={`/blog/${p.id}/`}>
            <div><p class="row__meta">{fmt(p.data.date)}</p><h3 class="row__t">{p.data.title}</h3></div>
            <div><p class="row__s">{p.data.summary}</p><span class="row__go" aria-hidden="true">읽기 →</span></div>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="about" id="about" aria-label="소개">
    <div class="sheet rv">
      <img class="sheet__pic" src="/avatar.png" alt="최경성" width="56" height="56" />
      <p>저는 교육 콘텐츠를 기획하고 기술 문서를 씁니다. 학습자의 눈높이에서 시작해, 왜 그렇게 설계됐는지부터 설명하는 자료를 만듭니다.</p>
      <p>처음 접하는 사람도 혼자 힘으로 이해할 수 있는 문서와 커리큘럼이 목표입니다.</p>
      <p class="sheet__sign"><em>최경성</em><span>교육 콘텐츠 기획자 · 기술 문서 작성자</span></p>
      <ul class="tl">
        {experience.map((e) => (
          <li><span class="tl__when">{e.when}</span><p class="tl__org">{e.org}</p></li>
        ))}
        {education.map((e) => (
          <li><span class="tl__when">{e.when}</span><p class="tl__org">{e.what}</p></li>
        ))}
      </ul>
      <ul class="tags">{skills.map((s) => <li>{s}</li>)}</ul>
      <p class="example-note">경력·학력·연락처는 예시(placeholder) 자료입니다. 실제 정보로 바꿔 주세요.</p>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-h">
    <img class="contact__bg" src="/img/contact-fog.jpg" alt="안개 낀 물 위에 서 있는 표지 말뚝" width="2400" height="1350" loading="lazy" />
    <div class="ccard rv">
      <h2 id="contact-h" class="ccard__h">연락처</h2>
      <ul class="ccard__list">
        {contacts.map((c) => (
          <li><a href={c.href}><span>{c.k}</span><span>{c.label}</span></a></li>
        ))}
      </ul>
      <a class="ccard__btn" href="mailto:example@email.com">이메일 보내기</a>
    </div>
  </section>
</SiteLayout>

<style is:global>
  /* 첫 화면: 연한 청록 바탕 위의 파일철 */
  .hero{
    background:var(--tint); text-align:center; overflow:hidden;
    padding:96px var(--pad) 0; min-height:calc(100svh - var(--hdr));
    .hero__h{font-size:clamp(2.8rem,8.4vw,8rem); line-height:1.02; letter-spacing:-.03em; margin:0 auto 24px}
    .hero__p{font-size:clamp(1.05rem,1.2vw + .6rem,1.35rem); line-height:1.6; max-width:46ch; margin:0 auto 64px; color:var(--ink2)}
  }
  .fstack{position:relative; width:86%; margin-inline:auto; height:calc(64px*3 + 420px)}
  .fd{
    position:absolute; inset-inline:0; top:calc((var(--n) - 1)*64px); height:460px; text-decoration:none; transition:translate .2s;
    &:hover{translate:0 -8px}
    &:focus-visible{outline-offset:-4px}
    .fd__tab{
      position:absolute; top:-40px; left:var(--tl); height:40px; padding-inline:34px;
      display:flex; align-items:center; font-size:1.1rem; white-space:nowrap;
      background:var(--deep); color:var(--deep-ink); clip-path:polygon(0 100%,7% 0,93% 0,100% 100%);
    }
    .fd__btn{position:absolute; top:32px; left:32px}
  }
  .fd--1{--n:1; --tl:4%;  background:oklch(74% .09 var(--h))}
  .fd--2{--n:2; --tl:26%; background:oklch(81% .075 var(--h))}
  .fd--3{--n:3; --tl:48%; background:oklch(88% .055 var(--h))}
  .fd--4{--n:4; --tl:70%; background:var(--paper)}
  .fd--4 .fd__tab{background:var(--accent); color:var(--accent-ink)}

  /* 구역 공통 */
  .sec{padding:120px var(--pad) 0; max-width:calc(var(--max) + 2*var(--pad)); margin-inline:auto; container-type:inline-size}
  .sec__head{margin-bottom:56px}
  .sec__h{font-size:clamp(2.4rem,6vw,4.5rem); line-height:1; letter-spacing:-.03em}
  .sec .rows{padding-bottom:0}

  /* 포트폴리오: 위로 쌓이는 폴더 */
  .bands{margin-inline:calc(-1*var(--pad)); padding-bottom:40px}
  .band{
    position:sticky; top:calc(var(--hdr) + 44px + var(--i)*64px); min-height:70svh; padding:0 var(--pad) 64px;
    .band__tab{
      position:absolute; bottom:100%; left:var(--pad); min-height:44px; padding-inline:40px;
      display:flex; align-items:center; font-size:1.4rem; font-weight:500; white-space:nowrap;
      clip-path:polygon(0 100%,5% 0,95% 0,100% 100%); background:var(--deep); color:var(--deep-ink);
    }
    .band__strip{height:64px; display:flex; align-items:center; justify-content:flex-end; font-size:.95rem}
    .band__in{display:grid; grid-template-columns:repeat(12,1fr); column-gap:24px; align-items:start}
    .band__img{grid-column:1 / span 7; width:100%; height:auto; aspect-ratio:16/10; object-fit:cover}
    .band__txt{grid-column:9 / span 4}
    .band__s{margin-block:12px 16px; font-size:1.05rem; line-height:1.75}
    .band__n{margin-bottom:16px; font-variant-numeric:tabular-nums}
    .tags{margin-bottom:28px}
  }
  .band--1{background:var(--surface2)}
  .band--2{background:var(--surface3)}
  .band--2 .band__tab{background:var(--accent); color:var(--accent-ink)}
  .band--3{background:oklch(84% .05 var(--h))}

  /* 자료실: 실제 화면 이미지가 있는 두 칸 */
  .lib{display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr)); gap:32px}
  .lib__item{
    display:block; text-decoration:none; background:var(--surface); padding:20px 20px 32px; transition:background .2s, translate .2s;
    &:hover{background:var(--surface2); translate:0 -4px}
    img{width:100%; height:auto; aspect-ratio:16/10; object-fit:cover; margin-bottom:22px}
    .lib__meta{font-size:.95rem; color:var(--ink3); margin-bottom:6px}
    .lib__t{font-size:1.6rem; font-weight:500; line-height:1.3; letter-spacing:-.02em; margin-bottom:10px}
    .lib__s{line-height:1.75; padding-inline:4px}
    .lib__meta,.lib__t{padding-inline:4px}
  }

  /* 소개: 편지지 */
  .about{background:var(--tint); margin-top:140px; padding:140px var(--pad); display:flex; justify-content:center}
  .sheet{
    position:relative; background:var(--paper); width:100%; max-width:640px; padding:56px 56px 64px; margin-bottom:12px;
    &::after{content:""; position:absolute; inset-inline:0; bottom:-12px; height:12px; background:radial-gradient(circle at 12px 0, var(--paper) 12px, transparent 12.5px) 0 0/24px 12px repeat-x}
    .sheet__pic{width:56px; height:56px; border-radius:50%; object-fit:cover; background:var(--surface2); margin-bottom:28px}
    p{margin-bottom:1.1em; line-height:1.8}
    .sheet__sign{margin-block:32px 36px; em{display:block; font-size:1.5rem} span{font-size:.92rem; color:var(--ink3)}}
    .tags{margin-top:32px}
    .example-note{margin:36px 0 0; padding:12px 16px; background:var(--surface); font-size:.92rem; color:var(--ink2)}
  }
  .tl{
    list-style:none; display:flex; flex-direction:column; gap:14px;
    li{display:grid; grid-template-columns:130px 1fr; gap:16px; align-items:baseline}
    .tl__when{font-size:.92rem; color:var(--ink3); font-variant-numeric:tabular-nums}
    .tl__org{margin:0!important; font-weight:500}
  }

  /* 연락처: 사진 위의 카드 */
  .contact{
    position:relative; height:140svh; min-height:900px;
    .contact__bg{position:sticky; top:0; width:100%; height:100svh; object-fit:cover}
  }
  .ccard{
    position:absolute; top:60px; right:60px; width:380px; background:var(--paper); padding:32px 32px 0;
    .ccard__h{font-size:1.9rem; margin-bottom:20px; letter-spacing:-.02em}
    .ccard__list{list-style:none; margin-bottom:28px;
      a{display:flex; justify-content:space-between; gap:16px; padding-block:8px; text-decoration:none; &:hover{color:var(--accent)}}
      a span:last-child{text-align:right}
    }
    .ccard__btn{display:flex; align-items:center; justify-content:center; height:52px; margin-inline:-32px; background:var(--accent); color:var(--accent-ink); text-decoration:none; font-weight:500; transition:background .18s; &:hover{background:var(--accent-dk)}}
  }

  @media (max-width:820px){
    .hero{padding-top:64px; min-height:0}
    .hero .hero__h{font-size:15vw; margin-bottom:20px}
    .hero .hero__p{margin-bottom:48px; font-size:1.05rem}
    .fstack{width:calc(100% + 40px); margin-inline:-20px; height:calc(52px*3 + 300px)}
    .fd{top:calc((var(--n) - 1)*52px); height:340px;
      .fd__tab{top:-32px; height:32px; padding-inline:20px; font-size:.95rem}
      .fd__btn{inset-inline:20px; text-align:center; top:24px; left:20px}
    }
    .fd--1{--tl:3%} .fd--2{--tl:34%} .fd--3{--tl:8%} .fd--4{--tl:48%}
    .sec{padding-top:80px}
    .sec__head{margin-bottom:36px}
    .bands{margin-inline:-20px}
    .band{position:relative; top:auto; min-height:0; padding-bottom:40px; margin-top:44px;
      .band__tab{font-size:1.1rem; min-height:40px; padding:8px 24px; white-space:normal; max-width:calc(100% - 40px); line-height:1.25; clip-path:polygon(0 100%,4% 0,96% 0,100% 100%)}
      .band__strip{height:48px}
      .band__in{display:block}
      .band__img{aspect-ratio:4/3; margin-bottom:20px}
    }
    .about{padding-block:96px; margin-top:96px}
    .sheet{padding:40px 24px 56px}
    .tl li{grid-template-columns:1fr; gap:2px}
    .contact{height:auto; min-height:0}
    .contact .contact__bg{position:static; height:70svh}
    .ccard{position:relative; inset:auto; width:auto; margin:-80px 16px 0}
  }
</style>
