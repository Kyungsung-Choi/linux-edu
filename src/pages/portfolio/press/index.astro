---
import SiteLayout from '../../../layouts/SiteLayout.astro';

// 날짜별 기사 데이터: src/data/press/YYYY-MM-DD.json (scripts/press-upload.mjs 가 저장)
// 같은 날짜의 PDF 가 public/press/YYYY-MM-DD.pdf 에 있으면 내려받기 링크가 생긴다.
interface Article { images?: { src: string; alt: string }[]; kicker?: string; headline: string; sub?: string; body: string; source_title?: string; scope?: string }
interface Issue { category?: string; title: string; band_left?: string; section?: string; date: string; source_label?: string; glance?: string[]; footnote?: string; articles: Article[] }

const files = import.meta.glob<Issue>('../../../data/press/*.json', { eager: true, import: 'default' });
const issues = Object.entries(files)
  .map(([f, data]) => ({ day: f.match(/(\d{4}-\d{2}-\d{2}(?:_[a-z0-9]+)?)\.json$/)?.[1] ?? '', data }))
  .filter((i) => i.day)
  .map((i) => ({ ...i, cat: i.data.category ?? (/WSJ|월스트리트/.test(i.data.band_left ?? i.data.title) ? 'WSJ' : /Economist|이코노미스트/.test(i.data.band_left ?? i.data.title) ? '이코노미스트' : /블로그/.test(i.data.band_left ?? i.data.title) ? '블로그' : '기타') }))
  .sort((a, b) => b.day.localeCompare(a.day));
const cats = [...new Set(issues.map((i) => i.cat))];
const pdfs = new Set(Object.keys(import.meta.glob('../../../../public/press/*.pdf')).map((f) => f.match(/(\d{4}-\d{2}-\d{2}(?:_[a-z0-9]+)?)\.pdf$/)?.[1]));

// 본문 끝에 ' ▶ 첨언: ...' 이 붙은 기사는 요약과 첨언을 나눠 보여 준다.
const MARK = ' ▶ 첨언: ';
const parts = (b: string): [string, string] => { const k = b.indexOf(MARK); return k < 0 ? [b, ''] : [b.slice(0, k), b.slice(k + MARK.length)]; };

const TITLE = '언론기사 · 앵두아빠의 AI공부방';
const DESC = '해외 경제·비즈니스 기사를 쉬운 한국어로 요약해 날짜별로 쌓아 둡니다.';
---
<SiteLayout title={TITLE} description={DESC} path="/portfolio/press/" active="portfolio">
  

  {issues.length === 0 ? (
    <p class="empty">아직 올라온 기사가 없습니다.</p>
  ) : (
    <>
      <div class="cats" role="tablist" aria-label="분류">
        <button type="button" class="cat is-on" data-cat="">전체 <i>{issues.length}</i></button>
        {cats.map((c) => <button type="button" class="cat" data-cat={c}>{c} <i>{issues.filter((i) => i.cat === c).length}</i></button>)}
      </div>
      <div class="picker">
        <button type="button" id="older" class="pbtn" aria-label="이전 날짜">← 이전</button>
        <label class="picker__l" for="day">날짜</label>
        <select id="day">
          {issues.map((i) => <option value={i.day} data-cat={i.cat} data-label={`${i.day.slice(0, 10)} · ${i.cat}`}>{i.day.slice(0, 10)} · {i.cat}</option>)}
        </select>
        <button type="button" id="newer" class="pbtn" aria-label="다음 날짜">다음 →</button>
        <span class="zoom" role="group" aria-label="글자 크기">
          <button type="button" id="fs-down" class="pbtn" aria-label="글자 작게">가−</button>
          <button type="button" id="fs-up" class="pbtn" aria-label="글자 크게">가＋</button>
        </span>
        <span class="picker__n">{issues.length}건 보관</span>
      </div>

      {issues.map((i, idx) => (
        <section class="issue" data-day={i.day} data-cat={i.cat} hidden={idx !== 0}>
          <div class="paper">
            <div class="band">
              <span>{i.data.band_left ?? ''}</span>
              <b>{i.data.section ?? ''}</b>
              <span>{i.data.date} · A1{pdfs.has(i.day) && <a class="band__pdf" href={`/press/${i.day}.pdf`} target="_blank" rel="noopener">PDF</a>}</span>
            </div>
            <h1 class="mast">{i.data.title}</h1>
            {i.data.glance && i.data.glance.length > 0 && (
              <div class="glance">
                <span class="glance__l">오늘의 한눈에 보기</span>
                <ul>{i.data.glance.map((g) => <li>{g}</li>)}</ul>
              </div>
            )}
            {i.data.articles.slice(0, 1).map((a) => (
              <article class="top">
                {a.kicker && <span class="kick">{a.kicker}</span>}
                <h2 class="top__h">{a.headline}</h2>
                {a.sub && <p class="sub">{a.sub}</p>}
                <p class="tx cols">{parts(a.body)[0]}</p>
                {parts(a.body)[1] && <p class="note"><b>첨언</b>{parts(a.body)[1]}</p>}
                <p class="by">{i.data.source_label ?? '원문 요약'}{a.source_title ? ` · ${a.source_title}` : ''}{a.scope ? ` · 확인 범위: ${a.scope}` : ''}</p>
              </article>
            ))}
            <div class="others">
              {i.data.articles.slice(1).map((a) => (
                <article class="art">
                  {a.kicker && <span class="kick">{a.kicker}</span>}
                  <h2 class="art__h">{a.headline}</h2>
                  {a.sub && <p class="sub sub--s">{a.sub}</p>}
                  {a.images && a.images.map((im) => <figure class="fig"><img src={im.src} alt={im.alt} loading="lazy" /></figure>)}
                  <p class="tx">{parts(a.body)[0]}</p>
                  {parts(a.body)[1] && <p class="note"><b>첨언</b>{parts(a.body)[1]}</p>}
                  <p class="by">{i.data.source_label ?? '원문 요약'}{a.source_title ? ` · ${a.source_title}` : ''}{a.scope ? ` · 확인 범위: ${a.scope}` : ''}</p>
                </article>
              ))}
            </div>
            {i.data.footnote && <p class="foot">{i.data.footnote}</p>}
          </div>
        </section>
      ))}
    </>
  )}
</SiteLayout>

<script>
  const sel = document.getElementById('day') as HTMLSelectElement | null;
  const secs = Array.from(document.querySelectorAll<HTMLElement>('.issue'));
  const allOpts = sel ? Array.from(sel.options).map((o) => ({ v: o.value, c: o.dataset.cat ?? '', l: o.dataset.label ?? o.value })) : [];
  let curCat = '';
  const catBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat'));
  function setCat(c: string, push: boolean) {
    if (!sel) return;
    curCat = c;
    catBtns.forEach((b) => b.classList.toggle('is-on', b.dataset.cat === c));
    sel.innerHTML = '';
    allOpts.filter((o) => !c || o.c === c).forEach((o) => { const op = document.createElement('option'); op.value = o.v; op.textContent = o.l; sel.appendChild(op); });
    const n = document.querySelector('.picker__n'); if (n) n.textContent = sel.options.length + '건 보관';
    show(sel.options[0].value, push);
  }
  catBtns.forEach((b) => b.addEventListener('click', () => setCat(b.dataset.cat ?? '', true)));
  const older = document.getElementById('older') as HTMLButtonElement | null;
  const newer = document.getElementById('newer') as HTMLButtonElement | null;
  function show(day: string, push: boolean) {
    if (!sel) return;
    if (!Array.from(sel.options).some((o) => o.value === day)) day = sel.options[0].value;
    sel.value = day;
    secs.forEach((s) => { s.hidden = s.dataset.day !== day; });
    const i = sel.selectedIndex;
    if (newer) newer.disabled = i === 0;
    if (older) older.disabled = i === sel.options.length - 1;
    if (push) { try { history.replaceState(null, '', '?d=' + day); } catch (e) {} window.scrollTo(0, 0); }
  }
  sel?.addEventListener('change', () => show(sel.value, true));
  older?.addEventListener('click', () => sel && show(sel.options[Math.min(sel.selectedIndex + 1, sel.options.length - 1)].value, true));
  newer?.addEventListener('click', () => sel && show(sel.options[Math.max(sel.selectedIndex - 1, 0)].value, true));
  // 글자 크기: 기사 본문·부제·한눈에 보기에 적용, 이 브라우저에 기억
  const STEPS = [0.85, 0.95, 1, 1.15, 1.3, 1.5];
  let zi = 2;
  try { const raw = localStorage.getItem('press-fs'); const v = raw === null ? -1 : Number(raw); if (v >= 0 && v < STEPS.length) zi = v; } catch (e) {}
  const down = document.getElementById('fs-down') as HTMLButtonElement | null;
  const up = document.getElementById('fs-up') as HTMLButtonElement | null;
  function applyZoom() {
    document.documentElement.style.setProperty('--press-z', String(STEPS[zi]));
    if (down) down.disabled = zi === 0;
    if (up) up.disabled = zi === STEPS.length - 1;
    try { localStorage.setItem('press-fs', String(zi)); } catch (e) {}
  }
  down?.addEventListener('click', () => { zi = Math.max(0, zi - 1); applyZoom(); });
  up?.addEventListener('click', () => { zi = Math.min(STEPS.length - 1, zi + 1); applyZoom(); });
  applyZoom();
  {
    const d0 = new URLSearchParams(location.search).get('d') ?? '';
    const c0 = allOpts.find((o) => o.v === d0)?.c ?? '';
    if (c0) setCat(c0, false);
    show(d0, false);
  }
</script>

<style is:global>
  .empty{color:var(--ink2); padding:20px 0 80px}
  .picker{display:flex; flex-wrap:wrap; align-items:center; gap:10px; padding:0 0 28px}
  .picker__l{font-size:.85rem; color:var(--ink2)}
  #day{font:inherit; font-size:.95rem; color:var(--ink); background:var(--surface); border:1px solid var(--rule2); border-radius:8px; padding:6px 12px}
  .cats{display:flex; flex-wrap:wrap; gap:8px; padding:0 0 16px}
  .cat{font:inherit; font-size:.9rem; color:var(--ink2); background:var(--surface2); border:1px solid var(--rule); border-radius:999px; padding:6px 14px; cursor:pointer}
  .cat i{font-style:normal; font-size:.75rem; color:var(--ink3); margin-left:4px}
  .cat:hover{border-color:var(--accent-line); color:var(--accent)}
  .cat.is-on{background:var(--ink); color:var(--bg,#fff); border-color:var(--ink)}
  .cat.is-on i{color:inherit; opacity:.7}
  .pbtn{font:inherit; font-size:.85rem; color:var(--ink2); background:var(--surface2); border:1px solid var(--rule); border-radius:8px; padding:6px 12px; cursor:pointer}
  .pbtn:hover:not(:disabled){border-color:var(--accent-line); color:var(--accent)}
  .pbtn:disabled{opacity:.4; cursor:default}
  .zoom{display:inline-flex; gap:6px}
  .picker__n{font-size:.8rem; color:var(--ink3); margin-left:auto}
  /* 신문 지면: 사이트가 다크 테마여도 인쇄된 종이처럼 항상 흰 바탕·검정 글씨 (PDF와 같은 모양) */
  .issue{padding-bottom:70px}
  .paper{--pz:var(--press-z,1); background:#fcfbf7; color:#111; max-width:980px; margin:0 auto; padding:clamp(16px,3.2vw,40px) clamp(14px,3.6vw,44px) 28px; border:1px solid #d9d4c8; box-shadow:0 10px 30px -18px rgba(0,0,0,.6); font-family:'Nanum Myeongjo','Gowun Batang','AppleMyungjo',serif; line-height:1.7}
  .paper a{color:inherit}
  .band{display:flex; justify-content:space-between; align-items:baseline; gap:10px; border-bottom:1px solid #111; padding-bottom:5px; font-family:'Apple SD Gothic Neo','IBM Plex Sans KR',sans-serif; font-size:.82rem}
  .band b{font-weight:700}
  .band__pdf{margin-left:10px; padding:0 6px; border:1px solid #111; font-size:.72rem; text-decoration:none}
  .mast{font-family:'Nanum Myeongjo','Gowun Batang',serif; font-weight:800; text-align:center; font-size:clamp(1.55rem,4.6vw,2.7rem); line-height:1.25; letter-spacing:-.01em; margin:14px 0 14px; padding-bottom:12px; border-bottom:6px double #111; color:#111}
  .glance{border:1px solid #111; padding:0 12px 8px; margin:0 0 18px; font-family:'Apple SD Gothic Neo','IBM Plex Sans KR',sans-serif; font-size:calc(.86rem * var(--pz)); line-height:1.6}
  .glance__l{display:inline-block; background:#111; color:#fff; font-weight:700; font-size:.76rem; padding:2px 9px; margin:-1px 0 6px -12px}
  .glance ul{margin:0; padding-left:1.1em}
  .glance li{margin:3px 0}
  .kick{display:inline-block; font-family:'Apple SD Gothic Neo','IBM Plex Sans KR',sans-serif; font-size:.72rem; font-weight:700; color:#fff; background:#111; padding:1px 7px; margin-bottom:6px}
  .top{padding-bottom:6px}
  .top__h{font-family:'Nanum Myeongjo','Gowun Batang',serif; font-weight:800; text-align:center; font-size:clamp(1.55rem,4.2vw,2.5rem); line-height:1.3; letter-spacing:-.02em; margin:4px 0 10px; text-wrap:balance; word-break:keep-all; color:#111}
  .top .kick{display:table; margin-left:auto; margin-right:auto}
  .sub{font-weight:700; font-size:calc(1rem * var(--pz)); line-height:1.65; border-left:3px solid #111; padding-left:11px; margin:0 0 12px; color:#111}
  .sub--s{font-size:calc(.93rem * var(--pz))}
  .tx{margin:0; font-size:calc(1rem * var(--pz)); line-height:1.8; text-align:justify; text-indent:1em; word-break:normal; overflow-wrap:break-word; color:#111}
  .cols{column-count:2; column-gap:30px; column-rule:1px solid #8a8a8a}
  .others{column-count:2; column-gap:30px; column-rule:1px solid #8a8a8a; margin-top:14px}
  .fig{margin:6px 0 10px} .fig img{display:block; width:100%; height:auto; border:1px solid #ddd}
  .art{border-top:1px solid #111; padding:12px 0 14px; break-inside:auto}
  .art:first-child{border-top:0}
  .art__h{font-family:'Nanum Myeongjo','Gowun Batang',serif; font-weight:800; font-size:calc(1.3rem * var(--pz)); line-height:1.35; letter-spacing:-.015em; margin:2px 0 8px; color:#111; word-break:keep-all; break-after:avoid; text-wrap:balance}
  .note{margin:8px 0 0; padding:6px 10px; border-left:3px solid #111; background:#f1ede4; font-size:calc(.92rem * var(--pz)); line-height:1.7; color:#222}
  .note b{display:inline-block; margin-right:7px; padding:0 6px; background:#111; color:#fff; font-family:'Apple SD Gothic Neo','IBM Plex Sans KR',sans-serif; font-size:.72rem; font-weight:700}
  .by{margin:8px 0 0; text-align:right; font-family:'Apple SD Gothic Neo','IBM Plex Sans KR',sans-serif; font-size:.72rem; color:#555; line-height:1.5; text-indent:0}
  .foot{border-top:1px solid #111; margin:10px 0 0; padding-top:8px; text-align:center; font-family:'Apple SD Gothic Neo','IBM Plex Sans KR',sans-serif; font-size:.76rem; color:#555; line-height:1.6}
  @media (max-width:700px){
    .cols,.others{column-count:1}
    .band{flex-wrap:wrap}
    .tx{text-align:left}
  }
</style>
