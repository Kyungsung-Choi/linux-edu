---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const TITLE = '전자회로 기초 입문 강좌 · 앵두아빠의 AI공부방';
const DESC = '전기 지식이 전혀 없어도 브레드보드와 측정 기계로 부품이 하는 일을 직접 확인하며 배우는 전자회로 기초 강좌 목차입니다.';

// n = 회차 번호. 강좌를 만들면 해당 항목에 href를 넣어 링크로 바꾼다.
const parts: { t: string; note?: string; items: { n: string; t: string; d: string }[] }[] = [
  { t: '0부. 시작하기', items: [
    { n: '1', t: '전기란 무엇인가, 안전 수칙', d: '전기가 어떻게 흐르는지 물 흐름에 빗대어 알아보고, 건전지 전압을 직접 재 봅니다. 위험한 것과 안전한 것을 구분합니다.' },
    { n: '2', t: 'AOS02 사용법과 브레드보드', d: '측정 기계(멀티미터·오실로스코프)의 버튼과 단자 이름을 익히고, 브레드보드 구멍이 속에서 어떻게 이어져 있는지 확인합니다.' },
  ]},
  { t: '1부. 전기 기본', note: '건전지(9V 이하)로 안전하게', items: [
    { n: '3', t: '전압·전류·저항', d: '전기의 세 가지 기본 값이 각각 무엇인지, 어떤 기계로 어떻게 재는지 직접 재면서 구분합니다.' },
    { n: '4', t: '옴의 법칙', d: '전압, 전류, 저항 사이의 곱셈·나눗셈 관계를 저항을 바꿔 가며 계산하고 측정값과 비교합니다.' },
    { n: '5', t: '직렬과 병렬', d: '부품을 한 줄로 잇거나 나란히 잇는 두 방식의 차이를 보고, 저항이 합쳐지는 규칙을 확인합니다.' },
    { n: '6', t: '분압기와 가변저항', d: '전압을 원하는 만큼 나누는 방법을 배웁니다. 오디오 볼륨 손잡이가 움직이는 원리와 같습니다.' },
  ]},
  { t: '2부. 기본 부품', note: '부품마다 하는 일이 다릅니다', items: [
    { n: '7', t: '저항 고르기', d: '저항에 칠해진 색 띠 읽는 법과, 저항이 열을 내는 이유, 알맞은 크기를 고르는 법을 배웁니다.' },
    { n: '8', t: '커패시터: 충전과 방전', d: '전기를 잠깐 모았다가 내보내는 부품입니다. 켜고 끄는 데 걸리는 시간을 직접 재 봅니다.' },
    { n: '9', t: '다이오드와 LED', d: '전기를 한 방향으로만 흐르게 하는 부품입니다. 방향을 바꾸면 LED가 왜 꺼지는지 확인합니다.' },
    { n: '10', t: '정류와 평활', d: '벽에서 나오는 것 같은 오르내리는 전기(교류)를 한쪽으로만 흐르는 전기(직류)로 바꾸는 과정을 파형으로 봅니다.' },
    { n: '11', t: '코일과 트랜스', d: '전선을 감으면 자석이 되는 원리와, 전압을 높이거나 낮추는 트랜스가 하는 일을 알아봅니다.' },
    { n: '12', t: '스위치·릴레이·스피커', d: '전기 신호가 딸깍 소리나 음악이 되는 과정을 확인합니다. 스피커 속 구조도 살펴봅니다.' },
  ]},
  { t: '3부. 트랜지스터', note: '작은 신호로 큰 신호를 움직입니다', items: [
    { n: '13', t: '트랜지스터는 전기 스위치', d: '아주 작은 전류로 더 큰 전류를 켜고 끄는 부품입니다. LED를 켜 보며 감을 잡습니다.' },
    { n: '14', t: '전류 증폭 (BJT)', d: '작은 전류가 몇 배로 커지는지 직접 재서 증폭이 무엇인지 숫자로 확인합니다.' },
    { n: '15', t: '바이어스와 동작점', d: '증폭이 잘 되는 자리를 잡는 법을 배웁니다. 자리가 틀리면 소리가 찌그러지는 이유를 봅니다.' },
    { n: '16', t: '첫 증폭기 만들기', d: '실제로 작은 신호를 넣고 오실로스코프로 커진 파형을 확인합니다.' },
    { n: '17', t: '이미터 폴로워와 MOSFET', d: '스피커처럼 힘이 필요한 곳에 신호를 보내는 방법과, 또 다른 종류의 트랜지스터를 알아봅니다.' },
  ]},
  { t: '4부. 연산증폭기와 타이머', items: [
    { n: '18', t: '연산증폭기 기본', d: '입력 둘, 출력 하나로 된 만능 증폭 부품입니다. 부품 속은 몰라도 쓰는 법부터 익힙니다.' },
    { n: '19', t: '반전·비반전 증폭', d: '저항 두 개만 바꿔도 몇 배로 키울지 정할 수 있다는 것을 계산하고 측정합니다.' },
    { n: '20', t: '필터: 저음과 고음 가르기', d: '낮은 소리만 통과시키거나 높은 소리만 통과시키는 회로를 만들어 소리 차이를 듣습니다.' },
    { n: '21', t: '비교기와 발진', d: '값을 비교해서 켜고 끄는 회로를 만들고, 빛 센서로 스위치처럼 써 봅니다.' },
    { n: '22', t: '555 타이머', d: '깜박이는 LED, 삑 소리를 내는 부품입니다. 저항과 커패시터 값으로 속도를 바꿉니다.' },
  ]},
  { t: '5부. 디지털과 아두이노', note: '아두이노 키트 구성품 확인 후 확정', items: [
    { n: '23', t: '0과 1, 논리 게이트', d: '켜짐·꺼짐 두 가지 상태로 판단하는 방식을 스위치 두 개로 직접 만들어 봅니다.' },
    { n: '24', t: '아두이노 첫걸음', d: '프로그램을 올려서 LED를 깜박입니다. 프로그램이 전기 신호를 어떻게 내보내는지 알아봅니다.' },
    { n: '25', t: '버튼 입력과 풀업', d: '버튼을 눌렀는지 읽는 법과, 아무것도 안 눌렀을 때 값이 흔들리지 않게 하는 이유를 배웁니다.' },
    { n: '26', t: '아날로그 읽기와 PWM', d: '가변저항 값을 숫자로 읽고, 그 값으로 LED 밝기를 부드럽게 바꿉니다.' },
    { n: '27', t: '센서 다루기', d: '온도·빛·거리를 숫자로 바꿔 읽는 법을 배웁니다.' },
  ]},
  { t: '6부. 종합', items: [
    { n: '28', t: '전원 만들기 (7805)', d: '9V 건전지로 안정적인 5V를 만들어 회로에 쓰는 방법을 배웁니다.' },
    { n: '29', t: '미니 앰프 (LM386)', d: '스마트폰 소리를 작은 스피커로 크게 들려 주는 앰프를 만듭니다.' },
    { n: '30', t: '종합 미니 프로젝트와 PCB 맛보기', d: '배운 것 중 하나를 골라 완성하고, 브레드보드 회로를 인쇄회로기판(PCB)으로 옮기는 과정을 구경합니다.' },
  ]},
];
---
<SiteLayout title={TITLE} description={DESC} path="/portfolio/electronics-basics/" active="portfolio">
  <article class="ta">
    <h1 class="ta__t">전자회로 기초 입문 강좌</h1>
    <p class="ta__lead">
      전기를 전혀 몰라도 괜찮습니다. 어려운 말은 쓰지 않고, 물 흐름 같은 일상의 예로 먼저 설명한 뒤 브레드보드에 부품을 꽂고 직접 재 보면서 확인합니다.
      수학은 사칙연산이면 충분합니다. 매 회차는 "꽂기 → 측정하기 → 바꿔 보기 → 이유 알기" 순서입니다.
    </p>

    <p class="ta__status"><b>현재 상태</b>목차 확정(총 30회). 강좌는 필요할 때 한 편씩 만들어 이 목차에 연결합니다. 5부는 아두이노 키트 구성품을 확인한 뒤 부품을 확정합니다.</p>

    <section class="ta__box" aria-label="준비물">
      <h2>준비물</h2>
      <ul>
        <li>브레드보드, 멀티미터와 오실로스코프(ANENG AOS02), 아두이노 우노 R3 키트(5부)</li>
        <li>저항, LED, 커패시터 같은 부품은 회차 앞부분에 그림과 함께 안내합니다.</li>
      </ul>
    </section>

    <section class="ta__box ta__warn" aria-label="안전 안내">
      <h2>안전 안내</h2>
      <p>이 강좌의 모든 실습은 건전지나 USB 전원(9V 이하)만 씁니다. 콘센트(220V) 전기는 다루지 않습니다.</p>
    </section>

    {parts.map((p) => (
      <section class="ta__part">
        <h2 class="ta__ph">{p.t}{p.note && <span>{p.note}</span>}</h2>
        <ol class="ta__list">
          {p.items.map((i) => (
            <li>
              <span class="ta__n">{i.n}</span>
              <span class="ta__tt"><b>{i.t}</b><small>{i.d}</small></span>
              <em>준비 중</em>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <p class="ta__note">부품 값은 실습하면서 직접 측정해 확인한 뒤 확정합니다. 목차는 진행하면서 조정될 수 있습니다.</p>
  </article>
</SiteLayout>

<style is:global>
  .ta{max-width:820px; padding:56px 0 80px}
  .ta__t{font-weight:700; letter-spacing:-.03em; font-size:clamp(1.8rem,4.5vw,2.6rem); margin:0 0 16px; line-height:1.2}
  .ta__lead{color:var(--ink2); line-height:1.9; margin:0 0 18px}
  .ta__status{margin:0 0 20px; padding:10px 14px; background:var(--surface); border:1px solid var(--rule); border-radius:10px; font-size:.92rem}
  .ta__status b{display:block; font-size:.78rem; color:var(--accent); margin-bottom:2px}
  .ta__box{margin:0 0 16px; padding:14px 18px; background:var(--surface); border:1px solid var(--rule); border-radius:12px}
  .ta__box h2{font-size:1rem; margin:0 0 6px}
  .ta__box ul{margin:0; padding-left:1.2em; line-height:1.8}
  .ta__box p{margin:0; line-height:1.8}
  .ta__warn{border-color:var(--accent-line)}
  .ta__part{margin-top:34px}
  .ta__ph{font-size:1.2rem; margin:0 0 10px; letter-spacing:-.01em; display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 12px}
  .ta__ph span{font-size:.82rem; font-weight:400; color:var(--ink3)}
  .ta__list{list-style:none; margin:0; padding:0; border:1px solid var(--rule); border-radius:12px; overflow:hidden}
  .ta__list li{display:flex; align-items:baseline; gap:12px; padding:10px 14px; line-height:1.6; border-top:1px solid var(--rule)}
  .ta__list li:first-child{border-top:0}
  .ta__n{flex:none; min-width:2.2em; font-size:.85rem; font-weight:600; color:var(--ink3)}
  .ta__tt{flex:1} .ta__tt b{display:block} .ta__tt small{display:block; color:var(--ink2); font-size:.85rem; line-height:1.65; margin-top:2px}
  .ta__list a{flex:1; color:var(--accent); text-decoration:none}
  .ta__list em{flex:none; font-style:normal; font-size:.75rem; color:var(--ink3)}
  .ta__note{margin-top:30px; font-size:.8rem; color:var(--ink3)}
</style>
