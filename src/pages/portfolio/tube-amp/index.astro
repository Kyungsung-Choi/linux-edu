---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const TITLE = '진공관 앰프 입문 강좌 · 앵두아빠의 AI공부방';
const DESC = '전자회로를 전혀 몰라도 브레드보드와 멀티미터로 부품의 기능을 익히고, 진공관 앰프를 PCB로 설계·제작하기까지의 강좌 목차입니다.';

// n = 회차 번호. 강좌를 만들면 해당 항목에 href를 넣어 링크로 바꾼다.
const parts: { t: string; note?: string; items: { n: string; t: string; href?: string }[] }[] = [
  {
    t: '0부. 시작하기',
    items: [
      { n: '0-1', t: '강좌 안내와 학습 지도', href: '/portfolio/tube-amp/0-1/' },
      { n: '0-2', t: '안전 기본 (12V 이하 작업 원칙, 인두와 납)', href: '/portfolio/tube-amp/0-2/' },
      { n: '0-3', t: '부품 구매 가이드 (알리익스프레스 구매 요령, 차수별 주문, 도착 후 검수)', href: '/portfolio/tube-amp/0-3/' },
    ],
  },
  {
    t: '1부. 전기 기초',
    note: '12V 이하 · 브레드보드 · 멀티미터',
    items: [
      { n: '1', t: '전압·전류·저항과 멀티미터 사용법' },
      { n: '2', t: '브레드보드 읽기, LED 켜기' },
      { n: '3', t: '저항과 옴의 법칙' },
      { n: '4', t: '전압 분배와 가변저항 (볼륨의 원리)' },
      { n: '5', t: '커패시터 (충방전, 직류 차단·교류 통과)' },
      { n: '6', t: '다이오드 (정류의 원리)' },
      { n: '7', t: '소리는 작은 교류 전압: 이어폰과 스피커' },
      { n: '8', t: '교류·주파수·데시벨: 오실로스코프로 파형 보기' },
    ],
  },
  {
    t: '2부. 증폭의 원리',
    note: '12V 이하 · 트랜지스터와 연산증폭기',
    items: [
      { n: '9', t: '트랜지스터 ①: 스위치' },
      { n: '10', t: '트랜지스터 ②: 증폭, 바이어스와 동작점' },
      { n: '11', t: '첫 앰프: 이어폰 소리 키우기 (입출력 파형 비교, 클리핑)' },
      { n: '12', t: '연산증폭기와 이득 정하기' },
      { n: '13', t: 'RC 필터로 음색 만져 보기' },
      { n: '14', t: '인덕터와 트랜스' },
      { n: '15', t: '스피커를 울리는 전력 앰프 (LM386)' },
      { n: '16', t: '접지·임피던스, 잡음과 험 해결' },
    ],
  },
  {
    t: '3부. 진공관 알아보기',
    note: '저전압 실습',
    items: [
      { n: '17', t: '진공관이란: 히터, 캐소드, 그리드, 플레이트' },
      { n: '18', t: '저전압 진공관 실험 (그리드 전압과 플레이트 전류)' },
      { n: '19', t: '진공관 증폭단: 플레이트 저항, 캐소드 바이어스, 결합 커패시터' },
      { n: '20', t: '데이터시트, 특성 곡선, 부하선 읽기' },
      { n: '21', t: '전압 증폭단과 출력단, 출력 트랜스가 필요한 이유' },
    ],
  },
  {
    t: '4부. 고전압 안전과 전원부',
    note: '여기부터 200~400V · 반드시 안전 수칙부터',
    items: [
      { n: '22', t: '고전압 안전 수칙 (한 손 작업, 방전, 퓨즈, 접지, 절연 거리)' },
      { n: '23', t: '전원 트랜스, 정류, 필터 커패시터' },
      { n: '24', t: '히터 전원과 B+ 전원, 전압 측정법' },
      { n: '25', t: '전원부 제작과 단독 시험' },
    ],
  },
  {
    t: '5부. 진공관 앰프 설계',
    note: '12AX7 + EL84 싱글 앰프 (약 3~5W)',
    items: [
      { n: '26', t: '회로 구성: 전압 증폭과 출력단' },
      { n: '27', t: '바이어스·부하선 계산, 출력 트랜스 임피던스 정합' },
      { n: '28', t: '피드백, 잡음, 허밍 대책' },
      { n: '29', t: '전체 회로도 완성과 부품 목록(BOM)' },
    ],
  },
  {
    t: '6부. PCB 설계',
    items: [
      { n: '30', t: 'KiCad 설치와 회로도 작성' },
      { n: '31', t: '풋프린트 만들기 (진공관 소켓, 큰 커패시터, 트랜스 단자)' },
      { n: '32', t: '고전압 PCB 규칙 (배선 간격, 접지, 히터 배선, 부품 배치)' },
      { n: '33', t: '설계 규칙 점검, 거버 파일, 제조사 주문' },
    ],
  },
  {
    t: '7부. 제작과 시험',
    items: [
      { n: '34', t: '부품 검수와 납땜 순서' },
      { n: '35', t: '케이스 가공과 배선 (전원 스위치, 퓨즈, 접지)' },
      { n: '36', t: '단계별 전원 인가: 히터 → B+ → 신호' },
      { n: '37', t: '바이어스 조정과 첫 소리' },
      { n: '38', t: '문제 해결 사례집' },
      { n: '39', t: '마무리와 개선 아이디어' },
    ],
  },
];
---
<SiteLayout title={TITLE} description={DESC} path="/portfolio/tube-amp/" active="portfolio">
  <article class="ta">
    <h1 class="ta__t">진공관 앰프 입문 강좌</h1>
    <p class="ta__lead">
      전자회로를 전혀 몰라도 괜찮습니다. 브레드보드와 멀티미터로 부품의 기능을 직접 확인하며 익히고,
      마지막에는 진공관 앰프를 PCB로 설계해 만듭니다. 매 회차는 "꽂기 → 측정하기 → 바꿔 보기 → 이유 알기" 순서입니다.
    </p>

    <p class="ta__status"><b>현재 상태</b>목차 확정, 0부(시작하기) 3편 공개. 나머지 강좌는 필요할 때 한 편씩 만들어 이 목차에 연결합니다.</p>

    <section class="ta__box" aria-label="준비물">
      <h2>준비물</h2>
      <ul>
        <li>브레드보드, 멀티미터(4부부터는 직류 500V 이상 측정이 가능한 제품), 오실로스코프</li>
        <li>인두 (6부 이후)</li>
        <li>부품은 단계별로 나눠 구매합니다. 처음에는 1~2부 부품만 있으면 됩니다.</li>
      </ul>
    </section>

    <section class="ta__box ta__warn" aria-label="안전 안내">
      <h2>고전압 안내</h2>
      <p>진공관 앰프 내부에는 200~400V 직류가 흐르고, 전원을 꺼도 커패시터에 전기가 남을 수 있어 감전 위험이 있습니다.
      1~3부는 12V 이하 또는 저전압으로 진행하고, 4부의 안전 수칙을 배운 뒤에 고전압을 다룹니다. 220V 노출 배선은 다루지 않습니다.</p>
    </section>

    {parts.map((p) => (
      <section class="ta__part">
        <h2 class="ta__ph">{p.t}{p.note && <span>{p.note}</span>}</h2>
        <ol class="ta__list">
          {p.items.map((i) => (
            <li>
              <span class="ta__n">{i.n}</span>
              {i.href ? <a href={i.href}>{i.t}</a> : <span class="ta__tt">{i.t}</span>}
              {!i.href && <em>준비 중</em>}
            </li>
          ))}
        </ol>
      </section>
    ))}

    <p class="ta__note">회로 값과 부품 모델은 5부에서 데이터시트로 확인해 확정합니다. 목차는 진행하면서 조정될 수 있습니다.</p>
  </article>
</SiteLayout>

<style is:global>
  .ta{max-width:820px; padding:56px 0 80px}
  .ta__t{font-weight:700; letter-spacing:-.03em; font-size:clamp(1.8rem,4.5vw,2.6rem); margin:0 0 16px; line-height:1.2}
  .ta__lead{color:var(--ink2); line-height:1.9; margin:0 0 18px}
  .ta__status{margin:0 0 20px; padding:10px 14px; background:var(--surface); border:1px solid var(--rule); border-radius:10px; font-size:.92rem}
  .ta__status b{display:block; font-size:.78rem; color:var(--accent); margin-bottom:2px}
  .ta__box{margin:0 0 16px; padding:14px 18px; background:var(--surface); border:1px solid var(--rule); border-radius:12px}
  .ta__box h2{font-size:1rem; margin:0 0 6px}
  .ta__box ul{margin:0; padding-left:1.2em; line-height:1.8}
  .ta__box p{margin:0; line-height:1.8}
  .ta__warn{border-color:var(--accent-line)}
  .ta__part{margin-top:34px}
  .ta__ph{font-size:1.2rem; margin:0 0 10px; letter-spacing:-.01em; display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 12px}
  .ta__ph span{font-size:.82rem; font-weight:400; color:var(--ink3)}
  .ta__list{list-style:none; margin:0; padding:0; border:1px solid var(--rule); border-radius:12px; overflow:hidden}
  .ta__list li{display:flex; align-items:baseline; gap:12px; padding:10px 14px; line-height:1.6; border-top:1px solid var(--rule)}
  .ta__list li:first-child{border-top:0}
  .ta__n{flex:none; min-width:2.2em; font-size:.85rem; font-weight:600; color:var(--ink3)}
  .ta__tt{flex:1}
  .ta__list a{flex:1; color:var(--accent); text-decoration:none}
  .ta__list em{flex:none; font-style:normal; font-size:.75rem; color:var(--ink3)}
  .ta__note{margin-top:30px; font-size:.8rem; color:var(--ink3)}
</style>
