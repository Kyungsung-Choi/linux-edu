---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data/projects';

const TITLE = '포트폴리오 · 최경성';
const DESC = '교육 커리큘럼과 기술 문서를 만듭니다. 무엇을 하는지 나열하는 대신 왜 그렇게 만들어졌는지부터 설명합니다.';
const solo = projects.length === 1;
---
<SiteLayout title={TITLE} description={DESC} path="/portfolio/" active="portfolio" ogImageAlt="배우는 사람이 이해할 수 있는 자료를 만듭니다 — 최경성 포트폴리오">
  <section class={solo ? 'cards cards--solo cards--top' : 'cards cards--top'}>
    {projects.map((p) => (
      <a class="card" href={p.href}>
        <div class="card__top">
          <span class="card__kind">{p.kind}</span>
          <span class={p.status === '완료' ? 'chip chip--done' : 'chip'}>{p.status}</span>
        </div>
        <h2 class="card__t">{p.title}</h2>
        <p class="card__s">{p.summary}</p>
        {p.progress && (
          <div class="prog">
            <div class="prog__bar">
              <div class="prog__fill" style={`width:${(p.progress.done / p.progress.total) * 100}%`}></div>
            </div>
            <span class="prog__n">{p.progress.done} / {p.progress.total}개 챕터 공개</span>
          </div>
        )}
        <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
      </a>
    ))}
  </section>
</SiteLayout>
