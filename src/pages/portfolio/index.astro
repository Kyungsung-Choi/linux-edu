---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data/projects';

const items = projects.filter((p) => p.section === 'portfolio');
---
<SiteLayout title="포트폴리오 · 최경성" description="제작한 교육 과정과 교재 모음." path="/portfolio/" active="portfolio">
  <div class="wrap">
    <header class="ph">
      <h1 class="ph__h">포트폴리오</h1>
      <p class="ph__p">직접 기획하고 쓴 교육 과정과 교재입니다.</p>
    </header>
    <section class="rows" aria-label="포트폴리오 목록">
      {items.map((p) => (
        <a class="row" href={p.href} target={p.newWindow ? '_blank' : undefined} rel={p.newWindow ? 'noopener' : undefined}>
          <div>
            <p class="row__meta">{p.kind} · <span class="st">{p.status}</span> · {p.year}</p>
            <h2 class="row__t">{p.title}</h2>
          </div>
          <div>
            <p class="row__s">{p.summary}</p>
            {p.progress && <p class="row__meta">{p.progress.done} / {p.progress.total}개 챕터 공개</p>}
            <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
            <span class="row__go" aria-hidden="true">열어 보기 →</span>
          </div>
        </a>
      ))}
    </section>
  </div>
</SiteLayout>
