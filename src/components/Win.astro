---
interface Props { label?: string }
const { label = 'Windows' } = Astro.props;
---
<div class="xw">
  <div class="xw__h"><span class="chrome"><i></i><i></i><i></i></span>{label}</div>
  <div class="xw__b"><slot /></div>
</div>
<style>
  .xw{
    background:var(--surface); border:1px solid var(--rule); border-radius:11px;
    overflow:hidden; display:flex; flex-direction:column;
  }
  .xw__h{
    display:flex; align-items:center; gap:10px; padding:11px 16px;
    background:var(--surface2); border-bottom:1px solid var(--rule);
    font-size:.78rem; font-weight:600;
  }
  .xw__b{padding:14px 18px; font-size:.9rem; line-height:1.75; color:var(--ink2); flex:1}
  .xw__b :global(p){margin:0 0 .7rem; max-width:none}
  .xw__b :global(p:last-child){margin:0}
  .chrome{display:flex; gap:4px}
  .chrome i{width:8px; height:8px; border-radius:2px; background:var(--rule2); display:block}
</style>
