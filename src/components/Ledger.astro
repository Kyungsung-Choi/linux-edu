---
/**
 * T자 장부(대차대조표) 도식. 왼쪽 자산, 오른쪽 부채.
 *   <Ledger title="연준의 장부" left={['국채|+100']} right={['은행 지급준비금|+100']} />
 * 각 항목에서 '|' 뒤는 변화량 배지가 된다. '+'로 시작하면 증가색, '−'/'-'면 감소색.
 */
interface Props {
  title: string;
  left: string[];
  right: string[];
  leftLabel?: string;
  rightLabel?: string;
  note?: string;
}
const { title, left, right, leftLabel = '자산 (가진 것)', rightLabel = '부채 (갚거나 내줘야 할 것)', note } = Astro.props;
const parse = (s: string) => {
  const [t, d] = s.split('|').map((x) => x?.trim());
  const kind = !d ? '' : d.startsWith('+') ? 'up' : d.startsWith('-') || d.startsWith('−') ? 'down' : 'flat';
  return { t, d, kind };
};
---
<figure class="led">
  <figcaption class="led__title">{title}</figcaption>
  <div class="led__grid">
    <div class="led__col">
      <div class="led__h">{leftLabel}</div>
      <ul>{left.map((s) => { const x = parse(s); return <li><span>{x.t}</span>{x.d && <b class={`led__d led__d--${x.kind}`}>{x.d}</b>}</li>; })}</ul>
    </div>
    <div class="led__col">
      <div class="led__h">{rightLabel}</div>
      <ul>{right.map((s) => { const x = parse(s); return <li><span>{x.t}</span>{x.d && <b class={`led__d led__d--${x.kind}`}>{x.d}</b>}</li>; })}</ul>
    </div>
  </div>
  {note && <p class="led__note">{note}</p>}
</figure>
<style>
  .led {
    margin: 0 0 var(--gap-block); border: 1px solid var(--rule2); border-radius: 12px;
    background: var(--surface); overflow: hidden;
  }
  .led__title {
    padding: 11px 18px; font-weight: 600; font-size: .92rem;
    background: var(--surface2); border-bottom: 1px solid var(--rule2);
  }
  .led__grid { display: grid; grid-template-columns: 1fr 1fr; }
  .led__col { padding: 12px 18px 14px; margin: 0 !important; }
  .led__col + .led__col { border-left: 2px solid var(--rule2); }
  .led__h {
    font-family: var(--mono); font-size: .66rem; font-weight: 600; letter-spacing: .1em;
    color: var(--ink3); margin-bottom: 8px;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 10px;
    font-size: .9rem; line-height: 1.55; padding: 4px 0; margin: 0 !important; max-width: none;
    border-bottom: 1px dashed var(--rule);
  }
  li:last-child { border-bottom: 0; }
  .led__d {
    font-family: var(--mono); font-size: .78rem; font-weight: 600; white-space: nowrap;
    border-radius: 5px; padding: 1px 7px;
  }
  .led__d--up { color: var(--ok); background: var(--ok-soft); }
  .led__d--down { color: var(--danger); background: var(--danger-soft); }
  .led__d--flat { color: var(--ink2); background: var(--surface2); }
  .led__note {
    margin: 0 !important; padding: 10px 18px 12px; font-size: .84rem; color: var(--ink2);
    border-top: 1px solid var(--rule); max-width: none !important; line-height: 1.65;
  }
  @media (max-width: 560px) {
    .led__grid { grid-template-columns: 1fr; }
    .led__col + .led__col { border-left: 0; border-top: 2px solid var(--rule2); }
  }
</style>
