---
/** 약자 사전 검색창. 같은 페이지의 GlossaryTable 행을 걸러 보여준다. */
---
<div class="gl-search">
  <label for="gl-q">약자나 우리말로 찾기</label>
  <input id="gl-q" type="search" placeholder="예: 레포, IORB, 물가" autocomplete="off" />
  <p id="gl-empty" hidden>찾는 약자가 없습니다. 이 교재에서 다루지 않는 용어일 수 있습니다.</p>
</div>

<script>
  const input = document.getElementById('gl-q') as HTMLInputElement | null;
  const empty = document.getElementById('gl-empty');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-gl-row]').forEach((tr) => {
      const hit = !q || (tr.dataset.glText ?? '').includes(q);
      tr.hidden = !hit;
      if (hit) shown++;
    });
    if (empty) empty.hidden = shown > 0;
  });
</script>

<style>
  .gl-search { margin: 0 0 1.6rem; display: flex; flex-direction: column; gap: 6px; }
  label { font-size: .85rem; font-weight: 600; }
  input {
    font: inherit; font-size: .95rem; padding: 10px 14px; border-radius: 9px;
    border: 1px solid var(--rule2); background: var(--surface); color: var(--ink);
    max-width: 26rem; width: 100%; margin: 0 !important;
  }
  input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  p { margin: 0 !important; font-size: .85rem; color: var(--ink3); }
</style>
