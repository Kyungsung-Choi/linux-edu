---
// 첫 화면의 작은 캐릭터. SVG + CSS 모션이고, 마우스를 눈이 따라간다.
// 공식 Claude 로고/캐릭터가 아니라 분위기만 가져온 오리지널 그림이다.
---
<div class="mascot" aria-hidden="true">
  <svg viewBox="0 0 220 210" width="220" height="210" focusable="false">
    <ellipse class="m-shadow" cx="110" cy="196" rx="50" ry="8"/>
    <g class="m-char">
      <!-- 반짝이는 별 안테나 -->
      <g class="m-spark">
        <path d="M110 18 V50 M94 34 H126 M99 23 L121 45 M121 23 L99 45"/>
      </g>
      <circle class="m-dot m-dot--a" cx="150" cy="30" r="3.5"/>
      <circle class="m-dot m-dot--b" cx="72" cy="42" r="2.5"/>

      <!-- 몸 -->
      <rect class="m-body" x="48" y="62" width="124" height="112" rx="52"/>
      <ellipse class="m-feet" cx="86" cy="174" rx="17" ry="8"/>
      <ellipse class="m-feet" cx="134" cy="174" rx="17" ry="8"/>

      <!-- 얼굴 -->
      <g class="m-eyes">
        <ellipse class="m-eye" cx="88" cy="110" rx="6" ry="8.5"/>
        <ellipse class="m-eye" cx="132" cy="110" rx="6" ry="8.5"/>
      </g>
      <ellipse class="m-cheek" cx="74" cy="130" rx="9" ry="6"/>
      <ellipse class="m-cheek" cx="146" cy="130" rx="9" ry="6"/>
      <path class="m-mouth" d="M101 128 Q110 138 119 128"/>

      <!-- 손 흔드는 왼팔 -->
      <g class="m-arm">
        <ellipse class="m-body" cx="40" cy="124" rx="12" ry="18"/>
      </g>

      <!-- 교재를 든 오른팔 -->
      <g class="m-doc">
        <rect class="m-paper" x="150" y="116" width="42" height="54" rx="5"/>
        <path class="m-lines" d="M158 130 H184 M158 141 H184 M158 152 H174"/>
        <ellipse class="m-body" cx="150" cy="146" rx="11" ry="14"/>
      </g>
    </g>
  </svg>
</div>

<style is:global>
  .mascot{--c:oklch(73% .14 45); --c-dk:oklch(63% .15 42); --ink-m:oklch(22% 0 0); width:220px; flex:none; justify-self:end}
  .mascot svg{width:100%; height:auto; overflow:visible}
  .mascot .m-shadow{fill:var(--ink-m); opacity:.1; transform-origin:110px 196px; animation:m-shadow 3.2s ease-in-out infinite}
  .mascot .m-char{animation:m-bob 3.2s ease-in-out infinite}
  .mascot .m-body{fill:var(--c)}
  .mascot .m-feet{fill:var(--c-dk)}
  .mascot .m-eye{fill:var(--ink-m); transform-box:fill-box; transform-origin:center; animation:m-blink 5s infinite}
  .mascot .m-eyes{transform:translate(var(--ex,0px), var(--ey,0px)); transition:transform .12s ease-out}
  .mascot .m-cheek{fill:oklch(80% .12 25); opacity:.65}
  .mascot .m-mouth{fill:none; stroke:var(--ink-m); stroke-width:3; stroke-linecap:round}
  .mascot .m-spark{transform-origin:110px 34px; animation:m-spin 9s linear infinite}
  .mascot .m-spark path{fill:none; stroke:var(--c-dk); stroke-width:6; stroke-linecap:round}
  .mascot .m-dot{fill:var(--c); transform-box:fill-box; transform-origin:center; animation:m-twinkle 2.4s ease-in-out infinite}
  .mascot .m-dot--b{animation-delay:1.1s}
  .mascot .m-arm{transform-origin:46px 112px; animation:m-wave 2.6s ease-in-out infinite}
  .mascot .m-doc{transform-origin:170px 150px; animation:m-doc 3.2s ease-in-out infinite}
  .mascot .m-paper{fill:oklch(97% 0 0); stroke:oklch(82% 0 0); stroke-width:2}
  .mascot .m-lines{fill:none; stroke:oklch(45% 0 0); stroke-width:3; stroke-linecap:round}

  @keyframes m-bob{0%,100%{transform:translateY(0)} 50%{transform:translateY(-7px)}}
  @keyframes m-shadow{0%,100%{transform:scaleX(1); opacity:.1} 50%{transform:scaleX(.88); opacity:.07}}
  @keyframes m-blink{0%,92%,100%{transform:scaleY(1)} 95%{transform:scaleY(.1)}}
  @keyframes m-spin{to{transform:rotate(360deg)}}
  @keyframes m-twinkle{0%,100%{transform:scale(.6); opacity:.4} 50%{transform:scale(1.25); opacity:1}}
  @keyframes m-wave{0%,55%,100%{transform:rotate(0)} 62%{transform:rotate(-28deg)} 70%{transform:rotate(8deg)} 78%{transform:rotate(-24deg)} 86%{transform:rotate(4deg)}}
  @keyframes m-doc{0%,100%{transform:rotate(-4deg)} 50%{transform:rotate(3deg)}}

  @media (prefers-reduced-motion:reduce){
    .mascot *{animation:none!important; transition:none!important}
  }
</style>

<script>
  // 눈이 마우스를 살짝 따라간다 (움직임 줄이기 설정이면 끈다)
  const m = document.querySelector<HTMLElement>('.mascot');
  if (m && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    addEventListener('pointermove', (e) => {
      const r = m.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      const d = Math.hypot(dx, dy) || 1;
      const k = Math.min(1, d / 300) * 4;
      m.style.setProperty('--ex', `${(dx / d) * k}px`);
      m.style.setProperty('--ey', `${(dy / d) * k}px`);
    }, { passive: true });
  }
</script>
