---
const rows = Array.from({ length: 12 }, (_, i) => ({ n: i + 1, y: 70 + 20 * i }));
const cols = [
  ...['a', 'b', 'c', 'd', 'e'].map((l, i) => ({ l, x: 115 + 20 * i })),
  ...['f', 'g', 'h', 'i', 'j'].map((l, i) => ({ l, x: 235 + 20 * i })),
];
const rails = [55, 75, 355, 375];
---
<figure class="tl__fig">
  <svg class="sv" viewBox="0 0 660 420" role="img" aria-labelledby="lob-t lob-d">
    <title id="lob-t">브레드보드에 LED 회로를 꽂은 모습과 회로도</title>
    <desc id="lob-d">9V 건전지의 +가 점퍼선으로 2번 줄에 가고, 470옴 저항이 2번 줄에서 6번 줄로, LED의 긴 다리가 6번 줄, 짧은 다리가 9번 줄에 꽂히고, 9번 줄에서 점퍼선으로 −에 돌아온다.</desc>
    <text class="b l" x="30" y="22">브레드보드 배선</text>
    <text class="b l" x="470" y="22">회로도 (같은 회로)</text>

    <rect x="30" y="34" width="370" height="286" rx="10" fill="#eceef1" stroke="#8a8f98" stroke-width="2"/>
    <rect x="205" y="44" width="20" height="266" fill="#d4d7dc"/>
    <line x1="43" y1="62" x2="43" y2="298" stroke="#d63a2e" stroke-width="2"/>
    <line x1="87" y1="62" x2="87" y2="298" stroke="#2f5fc4" stroke-width="2"/>
    <text class="b c red" x="55" y="54">+</text>
    <text class="b c" x="75" y="54" style="fill:#2f5fc4">−</text>
    <g fill="#33363c">
      {rows.map((r) => (
        <>
          {rails.map((x) => <rect x={x - 4} y={r.y - 4} width="8" height="8" rx="1"/>)}
          {cols.map((c) => <rect x={c.x - 4} y={r.y - 4} width="8" height="8" rx="1"/>)}
        </>
      ))}
    </g>
    <g class="s c">
      {rows.map((r) => <text x="106" y={r.y + 4} text-anchor="end" style="font-size:11px">{r.n}</text>)}
    </g>

    <!-- 빨간 점퍼: + 레일 → 2번 줄 a -->
    <path d="M55 90Q85 60 115 90" fill="none" stroke="#d63a2e" stroke-width="4" stroke-linecap="round"/>
    <!-- 저항: c2 → c6 -->
    <line x1="155" y1="90" x2="155" y2="150" stroke="#8a8f98" stroke-width="3"/>
    <rect x="147" y="102" width="16" height="36" rx="7" fill="#e6cf9f" stroke="#b79d62" stroke-width="1.5"/>
    <rect x="147" y="108" width="16" height="4" fill="#f1d11c"/>
    <rect x="147" y="115" width="16" height="4" fill="#7b3fa0"/>
    <rect x="147" y="122" width="16" height="4" fill="#7b4a2a"/>
    <rect x="147" y="130" width="16" height="3" fill="#c9a23a"/>
    <!-- LED: d6(+) → d9(−) -->
    <line x1="175" y1="150" x2="175" y2="170" stroke="#8a8f98" stroke-width="3"/>
    <line x1="175" y1="196" x2="175" y2="210" stroke="#8a8f98" stroke-width="3"/>
    <path d="M165 196V180A10 10 0 0 1 185 180V196Z" fill="#e9605a" fill-opacity=".85" stroke="#b8403a" stroke-width="2"/>
    <!-- 검은 점퍼: 9번 줄 a → − 레일 -->
    <path d="M115 210Q95 180 75 210" fill="none" stroke="#2b2b2b" stroke-width="4" stroke-linecap="round"/>

    <!-- 건전지 -->
    <rect x="40" y="350" width="100" height="58" rx="6" fill="#3b4a63"/>
    <text class="b c" x="90" y="386" style="fill:#fff; font-size:18px">9V</text>
    <path d="M62 350L55 290" fill="none" stroke="#d63a2e" stroke-width="4" stroke-linecap="round"/>
    <path d="M118 350L75 290" fill="none" stroke="#2b2b2b" stroke-width="4" stroke-linecap="round"/>
    <text class="s" x="152" y="372">스냅 연결선: 빨강 = +,</text><text class="s" x="152" y="392">검정 = −</text>

    <!-- 라벨 -->
    <text class="b" x="240" y="104" style="paint-order:stroke; stroke:#eceef1; stroke-width:5px; stroke-linejoin:round">저항 470Ω</text>
    <text class="s" x="240" y="122" style="paint-order:stroke; stroke:#eceef1; stroke-width:5px; stroke-linejoin:round">노랑·보라·갈색·금색</text>
    <path d="M236 100L168 112" stroke="var(--ink2)" stroke-width="1.5"/>
    <text class="b" x="240" y="186" style="paint-order:stroke; stroke:#eceef1; stroke-width:5px; stroke-linejoin:round">LED</text>
    <text class="s" x="240" y="204" style="paint-order:stroke; stroke:#eceef1; stroke-width:5px; stroke-linejoin:round">긴 다리가 위(6번 줄)</text>
    <path d="M236 182L190 182" stroke="var(--ink2)" stroke-width="1.5"/>
    <text class="b" x="330" y="360">전류가 가는 길</text>
    <text class="s" x="330" y="380">+ 레일 → 2번 줄 → 저항 → 6번 줄</text>
    <text class="s" x="330" y="398">→ LED → 9번 줄 → − 레일</text>

    <!-- 회로도 -->
    <path d="M480 100V168M480 184V290H610V190M610 145V100H560M520 100H480" fill="none" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
    <line x1="462" y1="168" x2="498" y2="168" stroke="var(--ink)" stroke-width="4"/>
    <line x1="470" y1="184" x2="490" y2="184" stroke="var(--ink)" stroke-width="4"/>
    <text class="b" x="442" y="174">+</text>
    <text class="b" x="442" y="194">−</text>
    <text class="s" x="505" y="182">9V</text>
    <rect x="520" y="88" width="40" height="24" rx="3" fill="var(--ground)" stroke="var(--ink)" stroke-width="3"/>
    <text class="s c" x="540" y="80">470Ω</text>
    <path d="M596 145H624L610 173Z" fill="#e9605a" fill-opacity=".85" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round"/>
    <line x1="596" y1="175" x2="624" y2="175" stroke="var(--ink)" stroke-width="3"/>
    <text class="s" x="630" y="165">LED</text>
  </svg>
  <figcaption>그림 2. 9V 건전지 + 470Ω 저항 + LED. 저항이 LED에 흐르는 전류를 제한해 줍니다.</figcaption>
</figure>
