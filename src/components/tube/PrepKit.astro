---
// 준비물 그림. items: [{ k: 아이콘 이름, label: 이름, sub: 수량·설명, bands?: 저항 색 띠 }]
const { items = [], caption = '준비물 (그림은 대표적인 모양이며 실제 색과 크기는 다를 수 있습니다)' } = Astro.props;
const COL = { yellow: '#f1d11c', violet: '#7b3fa0', brown: '#7b4a2a', black: '#111111', red: '#d63a2e', orange: '#f08a24', gold: '#c9a23a' };
const BANDS = {
  r470: ['yellow', 'violet', 'brown', 'gold'],
  r1k: ['brown', 'black', 'red', 'gold'],
  r47k: ['yellow', 'violet', 'red', 'gold'],
  r10k: ['brown', 'black', 'orange', 'gold'],
};
const ICON = {
  aos02: () => `<g transform="translate(53 6)"><rect width="44" height="88" rx="9" fill="#c0392b"/><rect x="3" y="3" width="38" height="82" rx="7" fill="#2e2e32"/>
    <rect x="7" y="8" width="30" height="24" rx="3" fill="#171719"/><text x="35" y="27" text-anchor="end" style="font-size:12px; font-weight:700; fill:#fff; font-family:ui-monospace,Menlo,monospace">1.52</text>
    ${[0, 1, 2, 3].map((i) => `<rect x="${7 + i * 8}" y="36" width="6.5" height="5" rx="1.5" fill="#8a2a20"/><rect x="${7 + i * 8}" y="44" width="6.5" height="5" rx="1.5" fill="${i === 0 ? '#c0392b' : '#4a4a50'}"/>`).join('')}
    <circle cx="22" cy="62" r="11" fill="#3a3a3f"/><circle cx="22" cy="62" r="5" fill="#55555c"/>
    ${[9, 18, 27, 36].map((x, i) => `<circle cx="${x}" cy="80" r="3" fill="#111" stroke="${i === 3 ? '#e24a3b' : i === 2 ? '#eee' : '#888'}" stroke-width="1.5"/>`).join('')}</g>`,
  aa: () => `<g transform="translate(26 32)"><rect width="84" height="30" rx="6" fill="#3a3a3a"/><rect width="20" height="30" rx="6" fill="#c9a23a"/><rect x="84" y="10" width="8" height="10" rx="2" fill="#c9ccd1" stroke="#8a8f98"/>
    <text x="52" y="20" text-anchor="middle" style="font-size:13px; font-weight:800; fill:#fff">AA</text></g>`,
  v9: () => `<g transform="translate(50 0)"><path d="M20 20Q-4 20 -8 46" fill="none" stroke="#d63a2e" stroke-width="3" stroke-linecap="round"/><path d="M24 20Q4 22 2 52" fill="none" stroke="#2b2b2b" stroke-width="3" stroke-linecap="round"/>
    <rect x="16" y="10" width="38" height="14" rx="3" fill="#33363c"/><rect x="14" y="24" width="42" height="68" rx="4" fill="#2b2b2b"/><rect x="14" y="24" width="42" height="10" fill="#c9a23a"/>
    <circle cx="26" cy="29" r="3.5" fill="#c9ccd1"/><circle cx="44" cy="29" r="2.5" fill="#c9ccd1"/>
    <text x="35" y="66" text-anchor="middle" style="font-size:16px; font-weight:800; fill:#fff">9V</text></g>`,
  bb: () => `<g transform="translate(30 14)"><rect width="90" height="68" rx="5" fill="#eceef1" stroke="#8a8f98" stroke-width="2"/><rect x="40" y="5" width="10" height="58" fill="#d4d7dc"/>
    <line x1="3" y1="5" x2="3" y2="63" stroke="#d63a2e" stroke-width="1.5"/>
    ${Array.from({ length: 7 }, (_, r) => [6, 14, 22, 30, 38, 52, 60, 68, 76, 84].map((x) => `<rect x="${x - 1.5}" y="${9 + r * 8 - 1.5}" width="3" height="3" fill="#33363c"/>`).join('')).join('')}</g>`,
  jumper: () => `<g transform="translate(24 12)">
    <path d="M6 70Q6 8 36 8Q66 8 66 70" fill="none" stroke="#d63a2e" stroke-width="4" stroke-linecap="round"/>
    <path d="M30 70Q30 20 60 20Q90 20 90 70" fill="none" stroke="#2f5fc4" stroke-width="4" stroke-linecap="round"/>
    <path d="M54 70Q54 32 80 32Q106 32 106 70" fill="none" stroke="#3a9a4a" stroke-width="4" stroke-linecap="round"/>
    ${[6, 66, 30, 90, 54, 106].map((x) => `<rect x="${x - 2.5}" y="66" width="5" height="12" fill="#c9ccd1" stroke="#8a8f98"/>`).join('')}</g>`,
  res: (it) => {
    const b = (it.bands || BANDS.r470).map((n) => COL[n]);
    return `<g transform="translate(14 34)"><line x1="0" y1="15" x2="122" y2="15" stroke="#8a8f98" stroke-width="3"/><rect x="30" y="0" width="62" height="30" rx="13" fill="#e6cf9f" stroke="#b79d62" stroke-width="1.5"/>
    <rect x="42" y="1" width="6" height="28" fill="${b[0]}"/><rect x="53" y="1" width="6" height="28" fill="${b[1]}"/><rect x="64" y="1" width="6" height="28" fill="${b[2]}"/><rect x="80" y="1" width="5" height="28" fill="${b[3]}"/></g>`;
  },
  pot: () => `<g transform="translate(45 0)"><circle cx="30" cy="36" r="27" fill="#3a6ea5" stroke="#274b75" stroke-width="2"/><circle cx="30" cy="36" r="9" fill="#c4c8ce"/><line x1="30" y1="27" x2="30" y2="19" stroke="#8a8f98" stroke-width="2"/>
    <text x="30" y="58" text-anchor="middle" style="font-size:9px; font-weight:700; fill:#fff">B103</text>${[14, 30, 46].map((x) => `<line x1="${x}" y1="62" x2="${x}" y2="92" stroke="#8a8f98" stroke-width="3"/>`).join('')}</g>`,
  capEl: () => `<g transform="translate(45 0)"><path d="M12 70V14Q12 6 20 6H40Q48 6 48 14V70Z" fill="#3b4a63"/><path d="M12 70V14Q12 6 20 6H24V70Z" fill="#c9cfdb"/>
    <text x="18" y="30" text-anchor="middle" style="font-size:11px; font-weight:700; fill:#33363c">−</text><text x="18" y="48" text-anchor="middle" style="font-size:11px; font-weight:700; fill:#33363c">−</text>
    <text x="38" y="40" text-anchor="middle" style="font-size:8px; font-weight:700; fill:#fff">1000</text><text x="38" y="52" text-anchor="middle" style="font-size:8px; font-weight:700; fill:#fff">µF</text>
    <line x1="22" y1="70" x2="22" y2="86" stroke="#8a8f98" stroke-width="3"/><line x1="38" y1="70" x2="38" y2="96" stroke="#8a8f98" stroke-width="3"/></g>`,
  led: () => `<g transform="translate(45 0)"><path d="M16 54V30A14 14 0 0 1 44 30V54Z" fill="#e9605a" fill-opacity=".8" stroke="#b8403a" stroke-width="2"/><path d="M11 54H44V62H11Z" fill="#e9605a" stroke="#b8403a" stroke-width="2"/>
    <line x1="22" y1="62" x2="22" y2="96" stroke="#8a8f98" stroke-width="3"/><line x1="38" y1="62" x2="38" y2="84" stroke="#8a8f98" stroke-width="3"/></g>`,
  dio: (it) => `<g transform="translate(15 36)"><line x1="0" y1="12" x2="120" y2="12" stroke="#8a8f98" stroke-width="3"/><rect x="${it.small ? 40 : 35}" y="${it.small ? 4 : 0}" width="${it.small ? 40 : 50}" height="${it.small ? 16 : 24}" rx="3" fill="#33363c"/>
    <rect x="${it.small ? 66 : 70}" y="${it.small ? 4 : 0}" width="7" height="${it.small ? 16 : 24}" fill="#d9dce1"/></g>`,
  speaker: () => `<g transform="translate(37 8)"><rect width="76" height="80" rx="9" fill="#4b4f57"/><circle cx="38" cy="40" r="28" fill="#2b2d31" stroke="#8a8f98" stroke-width="3"/><circle cx="38" cy="40" r="9" fill="#6b7078"/>
    <rect x="-8" y="18" width="12" height="6" fill="#c9ccd1"/><rect x="-8" y="56" width="12" height="6" fill="#c9ccd1"/></g>`,
  jackmod: () => `<g transform="translate(32 14)"><rect x="4" width="88" height="68" rx="5" fill="#1f7a4d" stroke="#14583a" stroke-width="2"/><rect x="-8" y="20" width="30" height="28" rx="3" fill="#33363c"/><circle cx="-2" cy="34" r="5" fill="#111"/>
    ${[14, 34, 54].map((y, i) => `<circle cx="80" cy="${y}" r="4" fill="#c9ccd1"/><text x="68" y="${y + 3}" text-anchor="end" style="font-size:9px; font-weight:700; fill:#fff">${['L', 'R', 'GND'][i]}</text>`).join('')}</g>`,
  phone: () => `<g transform="translate(52 4)"><rect width="46" height="88" rx="9" fill="#2b2d31"/><rect x="4" y="8" width="38" height="66" rx="3" fill="#e8f0fb"/><text x="23" y="48" text-anchor="middle" style="font-size:20px; font-weight:700; fill:#2f5fc4">♪</text><rect x="17" y="79" width="12" height="3" rx="1" fill="#6b7078"/></g>`,
  cable: () => `<g transform="translate(10 20)"><rect x="0" y="22" width="40" height="14" rx="6" fill="#c9ccd1" stroke="#8a8f98"/><rect x="14" y="22" width="4" height="14" fill="#2b2b2b"/><rect x="24" y="22" width="4" height="14" fill="#2b2b2b"/>
    <path d="M40 29C80 29 70 64 108 60" fill="none" stroke="#33363c" stroke-width="5" stroke-linecap="round"/><rect x="108" y="53" width="26" height="14" rx="6" fill="#c9ccd1" stroke="#8a8f98"/></g>`,
  clips: () => `<g transform="translate(20 14)"><path d="M10 70C20 40 40 40 56 30" fill="none" stroke="#d63a2e" stroke-width="3.5" stroke-linecap="round"/><path d="M56 22L96 14L98 30L58 38Z" fill="#d63a2e" stroke="#8a2a20"/>
    <path d="M24 82C40 60 70 66 84 60" fill="none" stroke="#2b2b2b" stroke-width="3.5" stroke-linecap="round"/><path d="M82 52L118 46L120 62L84 68Z" fill="#2b2b2b" stroke="#000"/></g>`,
  probe: () => `<g transform="translate(8 14)"><rect x="104" y="26" width="24" height="26" rx="4" fill="#8a8f98" stroke="#555" stroke-width="2"/><circle cx="116" cy="39" r="7" fill="#33363c"/>
    <path d="M104 39C86 39 90 70 66 66" fill="none" stroke="#111" stroke-width="5" stroke-linecap="round"/><rect x="20" y="58" width="46" height="16" rx="7" fill="#222"/><rect x="36" y="62" width="14" height="8" rx="2" fill="#d63a2e"/>
    <line x1="0" y1="66" x2="20" y2="66" stroke="#8a8f98" stroke-width="3"/><text x="43" y="52" text-anchor="middle" style="font-size:9px; font-weight:700">1X 10X</text></g>`,
  stopwatch: () => `<g transform="translate(75 54)"><rect x="-6" y="-48" width="12" height="9" rx="2" fill="#6b7078"/><circle r="36" fill="#f4f6f8" stroke="#444" stroke-width="3"/><line x1="0" y1="0" x2="0" y2="-24" stroke="#d63a2e" stroke-width="3" stroke-linecap="round"/><line x1="0" y1="0" x2="16" y2="8" stroke="#444" stroke-width="3" stroke-linecap="round"/><circle r="3" fill="#444"/></g>`,
};
const cw = 148, gap = 8, ch = 154;
const rows = Math.ceil(items.length / 4);
let svg = '';
items.forEach((it, i) => {
  const x = 2 + (i % 4) * (cw + gap), y = 2 + Math.floor(i / 4) * (ch + 4);
  const k = it.k === 'r470' || it.k === 'r1k' || it.k === 'r47k' || it.k === 'r10k' ? 'res' : it.k;
  const item = k === 'res' ? { ...it, bands: BANDS[it.k] } : it;
  svg += `<g transform="translate(${x} ${y})"><rect width="${cw}" height="${ch - 4}" rx="12" fill="var(--surface)" stroke="var(--rule2)" stroke-width="1.5"/>`;
  svg += `<g transform="translate(-1 2)">${ICON[k](item)}</g>`;
  svg += `<text class="b c" x="${cw / 2}" y="118" style="font-size:14px">${it.label}</text><text class="s c" x="${cw / 2}" y="136" style="font-size:12px">${it.sub || ''}</text></g>`;
});
const H = rows * (ch + 4) + 2;
---
<figure class="tl__fig tl__fig--prep">
  <svg class="sv" viewBox={`0 0 ${4 * cw + 3 * gap + 4} ${H}`} role="img" aria-label={`준비물: ${items.map((i) => i.label).join(', ')}`}>
    <g set:html={svg} />
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
