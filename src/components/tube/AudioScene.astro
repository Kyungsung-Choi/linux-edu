---
// 소리 실습 장면. scene: tap | phone | scope | half
const { scene, caption = '' } = Astro.props;
const sine = (x0, w, yc, A, cyc, half = false, n = 80) =>
  Array.from({ length: n + 1 }, (_, i) => {
    let v = Math.sin((2 * Math.PI * cyc * i) / n);
    if (half) v = Math.max(0, v);
    return `${i ? 'L' : 'M'}${(x0 + (w * i) / n).toFixed(1)} ${(yc - A * v).toFixed(1)}`;
  }).join('');

const phone = (x, y) => `
  <rect x="${x}" y="${y}" width="86" height="160" rx="14" fill="#2b2d31"/><rect x="${x + 8}" y="${y + 14}" width="70" height="116" rx="6" fill="#e8f0fb"/>
  <text class="b c" x="${x + 43}" y="${y + 66}" style="font-size:14px">♪ 톤 앱</text><text class="b c" x="${x + 43}" y="${y + 90}" style="font-size:16px; fill:#2f5fc4">440Hz</text>
  <rect x="${x + 30}" y="${y + 144}" width="26" height="5" rx="2" fill="#6b7078"/>`;
const breakout = (x, y) => `
  <rect x="${x}" y="${y}" width="120" height="92" rx="6" fill="#1f7a4d" stroke="#14583a" stroke-width="2"/>
  <rect x="${x - 10}" y="${y + 28}" width="42" height="36" rx="4" fill="#33363c"/><circle cx="${x - 4}" cy="${y + 46}" r="7" fill="#111"/>
  <circle cx="${x + 114}" cy="${y + 20}" r="5" fill="#c9ccd1"/><circle cx="${x + 114}" cy="${y + 46}" r="5" fill="#c9ccd1"/><circle cx="${x + 114}" cy="${y + 72}" r="5" fill="#c9ccd1"/>
  <text class="b" x="${x + 86}" y="${y + 24}" style="fill:#fff; font-size:13px">L</text><text class="b" x="${x + 86}" y="${y + 50}" style="fill:#fff; font-size:13px">R</text><text class="b" x="${x + 70}" y="${y + 76}" style="fill:#fff; font-size:13px">GND</text>
  <text class="s c" x="${x + 60}" y="${y + 110}" style="font-size:12px">3.5mm 잭 모듈</text>`;
const speaker = (x, y) => `
  <rect x="${x}" y="${y}" width="110" height="100" rx="10" fill="#4b4f57"/><circle cx="${x + 62}" cy="${y + 50}" r="34" fill="#2b2d31" stroke="#8a8f98" stroke-width="3"/><circle cx="${x + 62}" cy="${y + 50}" r="11" fill="#6b7078"/>
  <rect x="${x - 14}" y="${y + 14}" width="18" height="8" fill="#c9ccd1"/><rect x="${x - 14}" y="${y + 70}" width="18" height="8" fill="#c9ccd1"/>
  <text class="b" x="${x - 28}" y="${y + 24}" style="font-size:15px; fill:#d63a2e">+</text><text class="b" x="${x - 28}" y="${y + 80}" style="font-size:15px; fill:#2f5fc4">−</text>`;

let svg = '';
let h = 300;
if (scene === 'phone') {
  svg += phone(20, 50) + breakout(190, 100) + speaker(450, 100);
  svg += `<path d="M63 210C63 262 120 262 170 150" fill="none" stroke="#33363c" stroke-width="5" stroke-linecap="round"/>`;
  svg += `<path d="M304 120C370 120 400 122 436 122" fill="none" stroke="#d63a2e" stroke-width="4" stroke-linecap="round"/>`;
  svg += `<path d="M304 172C370 172 400 178 436 178" fill="none" stroke="#2b2b2b" stroke-width="4" stroke-linecap="round"/>`;
  svg += `<text class="b" x="330" y="108" style="fill:#d63a2e">L → 스피커 +</text><text class="b" x="316" y="204">GND → 스피커 −</text>`;
  svg += `<text class="s" x="326" y="152" style="font-size:12px">R: 연결하지 않음</text><text class="s c" x="100" y="292" style="font-size:12px">오디오 케이블</text>`;
  svg += `<text class="s c" x="320" y="278">스마트폰 음량은 가장 작게 시작</text>`;
} else if (scene === 'scope') {
  h = 318;
  svg += phone(20, 40) + breakout(190, 80);
  svg += `<path d="M63 200C63 250 120 250 170 130" fill="none" stroke="#33363c" stroke-width="5" stroke-linecap="round"/>`;
  // ANENG AOS02 (오실로스코프 모드)
  svg += `<rect x="476" y="14" width="138" height="276" rx="24" fill="#c0392b"/><rect x="481" y="19" width="128" height="266" rx="20" fill="#2e2e32"/>`;
  svg += `<rect x="489" y="30" width="112" height="124" rx="5" fill="#0f1a14"/>`;
  for (let i = 1; i < 6; i++) svg += `<line x1="${489 + i * 18.7}" y1="42" x2="${489 + i * 18.7}" y2="146" stroke="#2f6b47"/>`;
  for (let i = 1; i < 6; i++) svg += `<line x1="489" y1="${42 + i * 17.3}" x2="601" y2="${42 + i * 17.3}" stroke="#2f6b47"/>`;
  svg += `<path d="${sine(489, 112, 94, 28, 3)}" stroke="#7dffa8" stroke-width="2.5" fill="none"/>`;
  svg += `<text x="493" y="40" style="font-size:7px; fill:#7dffa8">RUN</text><text x="560" y="40" style="font-size:7px; fill:#7dffa8">M:0.5ms</text>`;
  [0, 1, 2, 3].forEach((i) => (svg += `<rect x="${487 + i * 28}" y="160" width="25" height="12" rx="3" fill="#8a2a20"/>`));
  svg += `<rect x="487" y="180" width="25" height="14" rx="4" fill="#4a4a50" stroke="#ffd166" stroke-width="2"/><text x="499.5" y="190" text-anchor="middle" style="font-size:6px; fill:#fff">AUTO</text>`;
  svg += `<rect x="571" y="180" width="30" height="14" rx="4" fill="#4a4a50" stroke="#ffd166" stroke-width="2"/><text x="586" y="190" text-anchor="middle" style="font-size:7px; fill:#fff; font-weight:700">MODE</text>`;
  svg += `<circle cx="545" cy="238" r="30" fill="#3a3a3f"/><circle cx="545" cy="238" r="15" fill="#55555c"/>`;
  svg += `<rect x="466" y="112" width="16" height="28" rx="3" fill="#8a8f98" stroke="#555" stroke-width="1.5"/><circle cx="470" cy="126" r="5" fill="#33363c"/>`;
  // 프로브: 머리 → BNC, 끝(빨강) → L, 접지 클립(검정) → GND
  svg += `<path d="M436 126H468" stroke="#111" stroke-width="5" stroke-linecap="round"/>`;
  svg += `<rect x="376" y="117" width="60" height="18" rx="7" fill="#222"/><rect x="396" y="121" width="16" height="10" rx="2" fill="#d63a2e"/>`;
  svg += `<text x="404" y="130" text-anchor="middle" style="font-size:6px; fill:#fff; font-weight:700">1X 10X</text>`;
  svg += `<path d="M376 121H342L312 100" fill="none" stroke="#d63a2e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="310" cy="100" r="5" fill="#d63a2e" stroke="#fff" stroke-width="1.5"/>`;
  svg += `<path d="M376 131H342L318 152" fill="none" stroke="#2b2b2b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M306 146h14l-2 12h-10z" fill="#2b2b2b"/>`;
  svg += `<text class="b" x="322" y="88" style="fill:#d63a2e; font-size:13px">프로브 끝 → L</text>`;
  svg += `<text class="b" x="322" y="176" style="font-size:13px">접지 클립 → GND</text>`;
  svg += `<text class="s c" x="406" y="108" style="font-size:11px">프로브 (1X / 10X 스위치)</text>`;
  svg += `<text class="s" x="404" y="152" style="font-size:11px">BNC 입력</text>`;
  svg += `<text class="s c" x="545" y="306" style="font-size:11px">MODE 키로 오실로스코프 모드</text>`;
  svg += `<text class="s c" x="190" y="306">접지 클립은 반드시 GND에만</text>`;
} else if (scene === 'half') {
  h = 330;
  svg += `<text class="b" x="30" y="40" style="font-size:16px">L (스마트폰 신호)</text>`;
  svg += `<path d="M30 70H110M170 70H300M300 70V120M300 160V230H30" fill="none" stroke="#2b2b2b" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>`;
  svg += `<path d="M110 54L110 86L152 70Z" fill="#fff" stroke="#2b2b2b" stroke-width="3" stroke-linejoin="round"/><line x1="152" y1="52" x2="152" y2="88" stroke="#2b2b2b" stroke-width="3.5"/>`;
  svg += `<text class="s c" x="131" y="106">1N4148</text><text class="s c" x="131" y="122" style="font-size:11px">띠 쪽 →</text>`;
  svg += `<rect x="288" y="120" width="24" height="40" rx="3" fill="#fff" stroke="#2b2b2b" stroke-width="3"/><text class="s" x="322" y="146">10kΩ</text>`;
  svg += `<circle cx="300" cy="70" r="5" fill="#2b2b2b"/><text class="b c" x="300" y="26" style="font-size:13px; fill:#d63a2e">프로브 끝 (이 점)</text>`;
  svg += `<path d="M300 34V62" stroke="#d63a2e" stroke-width="3"/><path d="M294 56L300 66L306 56" fill="#d63a2e" stroke="#d63a2e" stroke-width="2"/>`;
  svg += `<path d="M250 224H350M258 234H342M268 244H332" stroke="#2b2b2b" stroke-width="3" stroke-linecap="round" opacity="0"/>`;
  svg += `<text class="b" x="34" y="256" style="font-size:16px">GND (접지) · 접지 클립</text>`;
  svg += `<rect x="400" y="20" width="230" height="290" rx="12" fill="#f4f6f8" stroke="#d6dae0"/>`;
  svg += `<text class="b c" x="515" y="46">입력 (L)</text><path d="M420 64H610" stroke="#9aa0a8" stroke-dasharray="4 4"/><path d="${sine(420, 190, 92, 26, 3)}" stroke="#2f5fc4" stroke-width="3" fill="none"/>`;
  svg += `<text class="b c" x="515" y="182">출력 (프로브로 본 모습)</text><path d="M420 240H610" stroke="#9aa0a8" stroke-dasharray="4 4"/><path d="${sine(420, 190, 240, 26, 3, true)}" stroke="#d63a2e" stroke-width="3" fill="none"/>`;
  svg += `<text class="s c" x="515" y="284">아래쪽 반이 사라지고 위쪽만 남음</text>`;
} else if (scene === 'tap') {
  h = 280;
  const panel = (ox, rev) => {
    let s = `<rect class="panel" x="${ox}" y="5" width="310" height="270" rx="12"/>`;
    s += `<text class="b" x="${ox + 14}" y="32" style="font-size:15px">${rev ? '② 건전지 방향을 반대로' : '① 건전지 + → 스피커 +'}</text>`;
    s += speaker(ox + 180, 110).replace(/class="b"/g, 'class="b"');
    // 건전지
    s += `<rect x="${ox + 20}" y="150" width="86" height="40" rx="7" fill="#3a3a3a"/><rect x="${ox + 20}" y="150" width="20" height="40" rx="7" fill="#c9a23a"/><rect x="${ox + 106}" y="162" width="11" height="16" rx="2" fill="#c9ccd1" stroke="#8a8f98"/>`;
    s += `<text class="b" x="${ox + 112}" y="156" style="font-size:15px; fill:#d63a2e">+</text><text class="b" x="${ox + 8}" y="174" style="font-size:15px; fill:#2f5fc4">−</text><text class="s c" x="${ox + 62}" y="212">AA 건전지</text>`;
    const plusY = rev ? 199 : 123, minusY = rev ? 123 : 199; // 스피커 단자 y (y=110+14+8/2, 110+70+4)
    s += `<path d="M${ox + 117} 170C${ox + 150} 170 ${ox + 140} ${plusY} ${ox + 170} ${plusY}" fill="none" stroke="#d63a2e" stroke-width="3.5" stroke-linecap="round"/>`;
    s += `<path d="M${ox + 24} 190C${ox + 24} 250 ${ox + 150} 250 ${ox + 160} ${minusY}H${ox + 170}" fill="none" stroke="#2b2b2b" stroke-width="3.5" stroke-linecap="round"/>`;
    // 콘 움직임 화살표
    const dir = rev ? 'M' + (ox + 242) + ' 78V104' : 'M' + (ox + 242) + ' 104V78';
    s += `<path d="${dir}" stroke="${rev ? '#2f5fc4' : '#d63a2e'}" stroke-width="3.5" fill="none"/><path d="${rev ? `M${ox + 235} 98L${ox + 242} 108L${ox + 249} 98` : `M${ox + 235} 84L${ox + 242} 74L${ox + 249} 84`}" fill="none" stroke="${rev ? '#2f5fc4' : '#d63a2e'}" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>`;
    s += `<text class="b c" x="${ox + 242}" y="66" style="font-size:13px">${rev ? '콘이 들어감' : '콘이 나옴'}</text>`;
    s += `<text class="s c" x="${ox + 155}" y="262" style="font-size:12px">1초 이내로 댔다 떼기</text>`;
    return s;
  };
  svg += panel(5, false) + panel(335, true);
}
---
<figure class="tl__fig tl__fig--step">
  <svg class="sv" viewBox={`0 0 ${scene === 'tap' ? 660 : 640} ${h}`} role="img" aria-label={caption}>
    <g set:html={svg} />
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
