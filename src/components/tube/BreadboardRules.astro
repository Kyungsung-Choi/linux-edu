---
const rows = Array.from({ length: 12 }, (_, i) => ({ n: i + 1, y: 70 + 20 * i }));
const cols = [
  ...['a', 'b', 'c', 'd', 'e'].map((l, i) => ({ l, x: 115 + 20 * i })),
  ...['f', 'g', 'h', 'i', 'j'].map((l, i) => ({ l, x: 235 + 20 * i })),
];
const rails = [55, 75, 355, 375];
---
<figure class="tl__fig">
  <svg class="sv" viewBox="0 0 660 335" role="img" aria-labelledby="bbr-t bbr-d">
    <title id="bbr-t">브레드보드 내부 연결 규칙</title>
    <desc id="bbr-d">가로로 놓인 5개 구멍(a~e, f~j)은 안에서 서로 연결되고, 가운데 홈을 건너서는 연결되지 않으며, 양쪽 끝의 긴 줄(레일)은 세로로 쭉 연결된다.</desc>
    <rect x="30" y="30" width="370" height="290" rx="10" fill="#eceef1" stroke="#8a8f98" stroke-width="2"/>
    <rect x="205" y="42" width="20" height="266" fill="#d4d7dc"/>

    <!-- 강조 -->
    <rect x="46" y="60" width="18" height="240" rx="9" fill="#d63a2e" fill-opacity=".28"/>
    <rect x="106" y="121" width="100" height="18" rx="9" fill="#3a9a4a" fill-opacity=".4"/>
    <rect x="226" y="121" width="100" height="18" rx="9" fill="#2f5fc4" fill-opacity=".35"/>
    <line x1="43" y1="62" x2="43" y2="298" stroke="#d63a2e" stroke-width="2"/>
    <line x1="87" y1="62" x2="87" y2="298" stroke="#2f5fc4" stroke-width="2"/>
    <text class="b c red" x="55" y="52">+</text>
    <text class="b c" x="75" y="52" style="fill:#2f5fc4">−</text>

    <!-- 구멍 -->
    <g fill="#33363c">
      {rows.map((r) => (
        <>
          {rails.map((x) => <rect x={x - 4} y={r.y - 4} width="8" height="8" rx="1"/>)}
          {cols.map((c) => <rect x={c.x - 4} y={r.y - 4} width="8" height="8" rx="1"/>)}
        </>
      ))}
    </g>
    <g class="s c">
      {cols.map((c) => <text x={c.x} y="60" style="font-size:12px">{c.l}</text>)}
      {rows.map((r) => <text x="106" y={r.y + 4} text-anchor="end" style="font-size:11px">{r.n}</text>)}
    </g>

    <!-- 번호 표시 -->
    <circle cx="215" cy="100" r="10" fill="var(--danger)"/><text class="b c" x="215" y="105" style="fill:#fff; font-size:13px">2</text>
    <circle cx="332" cy="104" r="10" fill="#3a9a4a"/><text class="b c" x="332" y="109" style="fill:#fff; font-size:13px">1</text>
    <circle cx="65" cy="312" r="10" fill="var(--ink)"/><text class="b c" x="65" y="317" style="fill:#fff; font-size:13px">3</text>
    <text class="b c red" x="215" y="136" style="font-size:18px">✕</text>

    <!-- 설명 -->
    <g>
      <circle cx="425" cy="75" r="11" fill="#3a9a4a"/><text class="b c" x="425" y="80" style="fill:#fff; font-size:13px">1</text>
      <text class="b" x="445" y="72">가로 5개는 한 줄</text>
      <text class="s" x="445" y="92">같은 줄의 a~e 5개(또는</text>
      <text class="s" x="445" y="110">f~j 5개) 구멍은 안에서</text>
      <text class="s" x="445" y="128">서로 연결됨</text>

      <circle cx="425" cy="172" r="11" fill="var(--danger)"/><text class="b c" x="425" y="177" style="fill:#fff; font-size:13px">2</text>
      <text class="b" x="445" y="169">가운데 홈은 끊김</text>
      <text class="s" x="445" y="189">홈 건너편(e와 f)은</text>
      <text class="s" x="445" y="207">연결되지 않음</text>

      <circle cx="425" cy="249" r="11" fill="var(--ink)"/><text class="b c" x="425" y="254" style="fill:#fff; font-size:13px">3</text>
      <text class="b" x="445" y="246">양쪽 긴 줄은 세로 연결</text>
      <text class="s" x="445" y="266">전원(+ 빨강, − 파랑)을</text>
      <text class="s" x="445" y="284">나눠 쓰는 곳</text>
    </g>
  </svg>
  <figcaption>그림 1. 브레드보드 윗면과 내부 연결(구멍 아래 금속 띠). 일부 제품은 긴 줄이 중간에서 끊겨 있으니 멀티미터 통전 점검으로 확인합니다.</figcaption>
</figure>
