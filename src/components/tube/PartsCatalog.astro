<figure class="tl__fig">
  <svg class="sv" viewBox="0 0 700 400" role="img" aria-labelledby="pc-t pc-d">
    <title id="pc-t">1차 구매 부품 8가지의 생김새</title>
    <desc id="pc-d">저항, 세라믹 커패시터, 전해 커패시터, LED, 다이오드, 트랜지스터, IC, 가변저항의 대표적인 모양과 구별 포인트.</desc>

    <!-- 1 저항 -->
    <g transform="translate(15 10)">
      <rect class="panel" width="160" height="185" rx="12"/>
      <line class="lead" x1="15" y1="62" x2="145" y2="62"/>
      <rect x="42" y="46" width="76" height="32" rx="14" fill="#e6cf9f" stroke="#b79d62" stroke-width="1.5"/>
      <rect x="54" y="47" width="7" height="30" fill="#f1d11c"/>
      <rect x="67" y="47" width="7" height="30" fill="#7b3fa0"/>
      <rect x="80" y="47" width="7" height="30" fill="#d63a2e"/>
      <rect x="102" y="47" width="6" height="30" fill="#c9a23a"/>
      <text class="b c" x="80" y="150">저항</text>
      <text class="s c" x="80" y="170">색 띠로 값 표시</text>
    </g>
    <!-- 2 세라믹 -->
    <g transform="translate(185 10)">
      <rect class="panel" width="160" height="185" rx="12"/>
      <line class="lead" x1="68" y1="80" x2="68" y2="122"/>
      <line class="lead" x1="92" y1="80" x2="92" y2="122"/>
      <ellipse cx="80" cy="52" rx="28" ry="32" fill="#e08a3c" stroke="#a9611f" stroke-width="1.5"/>
      <text class="b c" x="80" y="58" style="fill:#33363c">104</text>
      <text class="b c" x="80" y="150">세라믹 커패시터</text>
      <text class="s c" x="80" y="170">극성 없음 · 104=100nF</text>
    </g>
    <!-- 3 전해 -->
    <g transform="translate(355 10)">
      <rect class="panel" width="160" height="185" rx="12"/>
      <path d="M56 88V32Q56 20 68 20H92Q104 20 104 32V88Z" fill="#3b4a63"/>
      <path d="M56 88V32Q56 20 68 20H72V88Z" fill="#c9cfdb"/>
      <line class="lead" x1="66" y1="88" x2="66" y2="112"/>
      <line class="lead" x1="94" y1="88" x2="94" y2="128"/>
      <text class="b c" x="64" y="48" style="fill:#33363c">−</text>
      <text class="b c" x="64" y="68" style="fill:#33363c">−</text>
      <text class="b c" x="80" y="150">전해 커패시터</text>
      <text class="s c" x="80" y="170">줄무늬 쪽이 −</text>
    </g>
    <!-- 4 LED -->
    <g transform="translate(525 10)">
      <rect class="panel" width="160" height="185" rx="12"/>
      <path d="M62 78V50A18 18 0 0 1 98 50V78Z" fill="#e9605a" fill-opacity=".75" stroke="#b8403a" stroke-width="2"/>
      <path d="M57 78H98V86H57Z" fill="#e9605a" fill-opacity=".9" stroke="#b8403a" stroke-width="2"/>
      <line class="lead" x1="68" y1="86" x2="68" y2="128"/>
      <line class="lead" x1="90" y1="86" x2="90" y2="110"/>
      <text class="b c" x="80" y="150">LED</text>
      <text class="s c" x="80" y="170">긴 다리가 +</text>
    </g>
    <!-- 5 다이오드 -->
    <g transform="translate(15 205)">
      <rect class="panel" width="160" height="185" rx="12"/>
      <line class="lead" x1="15" y1="62" x2="145" y2="62"/>
      <rect x="40" y="48" width="80" height="28" rx="3" fill="#33363c"/>
      <rect x="104" y="48" width="9" height="28" fill="#d9dce1"/>
      <text class="b c" x="80" y="150">다이오드</text>
      <text class="s c" x="80" y="170">띠 쪽이 −</text>
    </g>
    <!-- 6 트랜지스터 -->
    <g transform="translate(185 205)">
      <rect class="panel" width="160" height="185" rx="12"/>
      <path d="M56 86V56A24 24 0 0 1 104 56V86Z" fill="#33363c"/>
      <line x1="62" y1="56" x2="98" y2="56" stroke="#6b7078" stroke-width="1.5"/>
      <line class="lead" x1="66" y1="86" x2="66" y2="124"/>
      <line class="lead" x1="80" y1="86" x2="80" y2="124"/>
      <line class="lead" x1="94" y1="86" x2="94" y2="124"/>
      <text class="b c" x="80" y="150">트랜지스터</text>
      <text class="s c" x="80" y="170">핀 순서 확인 필수</text>
    </g>
    <!-- 7 IC -->
    <g transform="translate(355 205)">
      <rect class="panel" width="160" height="185" rx="12"/>
      <rect x="48" y="20" width="64" height="86" fill="#33363c" rx="3"/>
      <path d="M70 20A10 10 0 0 0 90 20Z" fill="var(--ground)"/>
      <circle cx="58" cy="32" r="3" fill="#d9dce1"/>
      <g fill="#9aa0a8">
        <rect x="38" y="30" width="10" height="7"/><rect x="38" y="48" width="10" height="7"/><rect x="38" y="66" width="10" height="7"/><rect x="38" y="84" width="10" height="7"/>
        <rect x="112" y="30" width="10" height="7"/><rect x="112" y="48" width="10" height="7"/><rect x="112" y="66" width="10" height="7"/><rect x="112" y="84" width="10" height="7"/>
      </g>
      <text class="s c" x="28" y="38">1</text><text class="s c" x="28" y="92">4</text>
      <text class="s c" x="132" y="38">8</text><text class="s c" x="132" y="92">5</text>
      <text class="b c" x="80" y="150">IC (DIP-8)</text>
      <text class="s c" x="80" y="170">홈 왼쪽 위가 1번</text>
    </g>
    <!-- 8 가변저항 -->
    <g transform="translate(525 205)">
      <rect class="panel" width="160" height="185" rx="12"/>
      <rect x="73" y="14" width="14" height="22" fill="#c4c8ce" stroke="#8a8f98" stroke-width="1"/>
      <line x1="80" y1="14" x2="80" y2="36" stroke="#8a8f98" stroke-width="1.5"/>
      <circle cx="80" cy="64" r="30" fill="#3a6ea5" stroke="#274b75" stroke-width="2"/>
      <text class="b c" x="80" y="69" style="fill:#fff; font-size:12px">B103</text>
      <line class="lead" x1="62" y1="92" x2="62" y2="124"/>
      <line class="lead" x1="80" y1="92" x2="80" y2="124"/>
      <line class="lead" x1="98" y1="92" x2="98" y2="124"/>
      <text class="b c" x="80" y="150">가변저항</text>
      <text class="s c" x="80" y="170">다리 3개 · B103</text>
    </g>
  </svg>
  <figcaption>그림 5. 1차로 구매할 부품의 대표적인 생김새(그림). 실제 부품은 색과 크기가 다를 수 있습니다.</figcaption>
</figure>
