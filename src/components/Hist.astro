---
/** 역사·유래 블록. 연도 배지 + 명조체로 '이야기 목소리'를 시각적으로 분리한다. */
interface Props { year: string; title: string }
const { year, title } = Astro.props;
---
<aside class="hist">
  <div class="hist__y">{year}</div>
  <div class="hist__c">
    <div class="hist__t">{title}</div>
    <div class="hist__b"><slot /></div>
  </div>
</aside>
<style>
  .hist{
    display:grid; grid-template-columns:76px 1fr; gap:0 22px;
    background:var(--plum-soft); border-radius:11px;
    padding:22px 26px 22px 22px; margin:0 0 1.6rem;
  }
  .hist__y{
    font-family:var(--mono); font-size:.9rem; font-weight:600; color:var(--plum);
    border-right:1px solid var(--plum-line); padding-right:16px;
    font-variant-numeric:tabular-nums; line-height:1.7;
  }
  .hist__t{font-weight:600; font-size:.95rem; margin-bottom:9px; color:var(--ink); font-family:var(--sans)}
  .hist__b{font-family:var(--serif); font-size:1rem; line-height:1.9; color:var(--ink2)}
  .hist__b :global(p){margin:0 0 .75rem; max-width:none; font-size:inherit}
  .hist__b :global(p:last-child){margin:0}
  @media (max-width:820px){
    .hist{grid-template-columns:1fr; gap:12px; padding:20px 22px}
    .hist__y{border-right:0; border-bottom:1px solid var(--plum-line); padding:0 0 10px}
  }
</style>
