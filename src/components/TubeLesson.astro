---
import SiteLayout from '../layouts/SiteLayout.astro';

interface Link { href: string; t: string }
interface Props { num: string; title: string; desc: string; prev?: Link; next?: Link }
const { num, title, desc, prev, next } = Astro.props;
---
<SiteLayout title={`${num}. ${title} · 진공관 앰프 입문 강좌`} description={desc} path={`/portfolio/tube-amp/${num}/`} active="portfolio">
  <article class="tl">
    <p class="tl__crumb"><a href="/portfolio/tube-amp/">진공관 앰프 입문 강좌</a> › {num}</p>
    <h1 class="tl__t">{title}</h1>
    <slot />
    <nav class="tl__nav" aria-label="이전·다음 회차">
      {prev ? <a href={prev.href}><small>이전</small>{prev.t}</a> : <span />}
      {next ? <a href={next.href} class="tl__next"><small>다음</small>{next.t}</a> : <span />}
    </nav>
  </article>
</SiteLayout>

<style is:global>
  .tl{--danger:oklch(.54 .19 27); --ok:oklch(.5 .12 150); max-width:820px; padding:48px 0 80px}
  .tl__crumb{font-size:.85rem; color:var(--ink3); margin:0 0 10px}
  .tl__crumb a{color:var(--ink3)}
  .tl__t{font-weight:700; letter-spacing:-.03em; font-size:clamp(1.7rem,4.5vw,2.4rem); margin:0 0 18px; line-height:1.25}
  .tl h2{font-size:1.3rem; margin:44px 0 12px; letter-spacing:-.01em; scroll-margin-top:80px}
  .tl h3{font-size:1.05rem; margin:22px 0 6px}
  .tl p{line-height:1.85; margin:0 0 12px}
  .tl ul,.tl ol{line-height:1.85; padding-left:1.3em; margin:0 0 12px}
  .tl li{margin-bottom:3px}
  .tl__lead{color:var(--ink2)}

  .tl__fig{margin:16px 0 22px}
  .tl__fig svg{display:block; width:100%; height:auto; max-width:640px; margin:0 auto; background:var(--ground); border:1px solid var(--rule); border-radius:12px}
  /* 좁은 화면에서는 글씨가 작아지지 않도록 그림을 옆으로 밀어 볼 수 있게 한다 */
  @media (max-width:640px){ .tl__fig{overflow-x:auto} .tl__fig svg{min-width:600px} }
  .tl__fig figcaption{font-size:.84rem; color:var(--ink3); margin-top:8px; line-height:1.6; text-align:center}

  .tl .sv text{fill:var(--ink); font-size:15px}
  .tl .sv .b{font-weight:700}
  .tl .sv .l{font-size:19px}
  .tl .sv .s{fill:var(--ink2); font-size:13px}
  .tl .sv .c{text-anchor:middle}
  .tl .sv .red{fill:var(--danger)}
  .tl .sv .grn{fill:var(--ok)}
  .tl .sv .box{fill:var(--surface); stroke:var(--rule2); stroke-width:1.5}
  .tl .sv .tube{stroke:var(--accent); stroke-width:2.5}
  .tl .sv .panel{fill:none; stroke:var(--rule); stroke-width:1.5}
  .tl .sv .wire{fill:none; stroke:var(--ink); stroke-width:3; stroke-linecap:round; stroke-linejoin:round}
  .tl .sv .lead{stroke:#8a8f98; stroke-width:3; stroke-linecap:round}
  .tl .sv .sig{stroke:var(--ink2); stroke-width:2.5; fill:none}
  .tl .sv .pwr{stroke:var(--danger); stroke-width:2.5; stroke-dasharray:6 4; fill:none}
  .tl .sv .mk{fill:var(--ink2)}
  .tl .sv .mkr{fill:var(--danger)}

  .tl__box{margin:14px 0 18px; padding:12px 16px; border-radius:10px; border:1px solid var(--rule); background:var(--surface); line-height:1.75; font-size:.95rem}
  .tl__box b.h{display:block; font-size:.78rem; margin-bottom:2px; color:var(--accent)}
  .tl__box.ok b.h{color:var(--ok)}
  .tl__box.warn{border-color:var(--danger); background:color-mix(in oklch, var(--danger) 6%, var(--ground))}
  .tl__box.warn b.h{color:var(--danger)}
  .tl__box p:last-child,.tl__box ul:last-child{margin-bottom:0}

  .tl__tb{width:100%; border-collapse:collapse; margin:8px 0 16px; font-size:.9rem}
  .tl__tb th,.tl__tb td{text-align:left; padding:8px 10px; border:1px solid var(--rule); line-height:1.55; vertical-align:top}
  .tl__tb thead th{background:var(--surface); white-space:nowrap}
  .tl__tb tbody th{background:var(--surface); font-weight:600}
  .tl__scroll{overflow-x:auto}
  .tl__scroll .tl__tb{min-width:560px}

  .tl__cards{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:10px; margin:12px 0 18px}
  .tl__card{padding:12px 14px; border:1px solid var(--rule); border-radius:12px; background:var(--surface); line-height:1.65; font-size:.92rem}
  .tl__card b{display:block; margin-bottom:3px; font-size:.98rem}
  .tl__card .n{display:inline-flex; align-items:center; justify-content:center; width:24px; height:24px; border-radius:50%; background:var(--ink); color:var(--ground); font-size:.8rem; margin-right:6px; vertical-align:1px}
  .tl__card.red{border-color:var(--danger); background:color-mix(in oklch, var(--danger) 6%, var(--ground))}
  .tl__card.green{border-color:var(--ok); background:color-mix(in oklch, var(--ok) 7%, var(--ground))}

  .tl__tag{display:inline-block; font-size:.72rem; font-weight:600; padding:1px 8px; border-radius:99px; border:1px solid var(--rule2); color:var(--ink2); margin-left:6px; vertical-align:2px}
  .tl__tag.red{color:var(--danger); border-color:var(--danger)}
  .tl__tag.green{color:var(--ok); border-color:var(--ok)}

  .tl__fig--prep{margin:8px 0 12px}
  .tl__fig--prep svg{max-width:640px; border:0; background:transparent}
  .tl__box .tl__fig--prep svg{margin:0 auto}
  /* 실습 단계 카드 */
  .tl__step{display:grid; grid-template-columns:34px minmax(0,1fr); gap:12px; padding:18px 0; border-top:1px solid var(--rule)}
  .tl__steps-start{border-top:0}
  .tl__sn{width:34px; height:34px; border-radius:50%; background:var(--ink); color:var(--ground); display:flex; align-items:center; justify-content:center; font-weight:700}
  .tl__sb h4{font-size:1.05rem; margin:4px 0 6px}
  .tl__sb p{margin:0 0 8px}
  .tl__sb ul,.tl__sb ol{margin:0 0 8px}
  .tl__sok{padding:8px 12px; background:var(--surface); border:1px solid var(--ok); border-radius:10px; font-size:.92rem; line-height:1.65}
  .tl__sok b{display:inline-block; margin-right:8px; font-size:.78rem; color:var(--ok)}
  .tl__fig--step{margin:10px 0 12px}
  .tl__fig--step svg{max-width:520px; margin:0}
  .tl__fig--step figcaption{text-align:left}
  @media (max-width:640px){
    .tl__step{grid-template-columns:minmax(0,1fr); gap:6px}
    .tl__sn{width:28px; height:28px; font-size:.85rem}
    .tl__fig--step svg{min-width:440px}
    .tl__fig--step::before{content:'← 옆으로 밀어서 전체 보기'; display:block; font-size:.72rem; color:var(--ink3); margin:0 0 4px}
  }
  .tl__learn{margin:26px 0 8px; padding:16px 18px; border:2px solid var(--accent); border-radius:14px; background:var(--surface)}
  .tl__learn h3{margin:0 0 8px; font-size:1.1rem}
  .tl__learn ul{margin:0; padding-left:1.2em}
  .tl__nav{display:flex; justify-content:space-between; gap:12px; margin-top:48px; padding-top:20px; border-top:1px solid var(--rule)}
  .tl__nav a{display:block; padding:10px 14px; border:1px solid var(--rule); border-radius:10px; text-decoration:none; color:var(--ink); line-height:1.5; max-width:48%}
  .tl__nav a small{display:block; font-size:.75rem; color:var(--ink3)}
  .tl__nav .tl__next{text-align:right; margin-left:auto}
</style>
