---
/**
 * 인터랙티브 해부도. 한 줄의 각 부분을 클릭하면 설명이 바뀐다.
 * 1주차 프롬프트, 2주차 `ls -l` 출력, 4주차 권한 비트에 재사용.
 * 한 페이지에 여러 개 올 수 있으므로 스크립트를 인스턴스 단위로 스코프한다.
 */
interface Segment { text?: string; sep?: string; label?: string; body?: string }
interface Props { segments: Segment[]; hint?: string }
const { segments, hint = '각 부분을 클릭하면 설명이 바뀝니다' } = Astro.props;

const parts = segments.filter((s) => s.text !== undefined);
const first = parts[0];
---
<div class="anat" data-anatomy>
  <div class="anat__line">
    {segments.map((s, i) =>
      s.sep !== undefined
        ? <span class="sep">{s.sep}</span>
        : <button
            type="button"
            class="seg"
            data-i={i}
            data-label={s.label}
            data-body={s.body}
            aria-pressed={s === first ? 'true' : 'false'}
          >{s.text}</button>
    )}
  </div>
  <div class="anat__out">
    <div class="anat__k" data-out-label>{first?.label}</div>
    <p class="anat__x" data-out-body>{first?.body}</p>
  </div>
  <p class="anat__hint">{hint}</p>
</div>

<script>
  document.querySelectorAll('[data-anatomy]').forEach((root) => {
    const segs = Array.from(root.querySelectorAll('.seg')) as HTMLElement[];
    const outK = root.querySelector('[data-out-label]') as HTMLElement | null;
    const outB = root.querySelector('[data-out-body]') as HTMLElement | null;
    segs.forEach((s) => {
      s.addEventListener('click', () => {
        segs.forEach((o) => o.setAttribute('aria-pressed', 'false'));
        s.setAttribute('aria-pressed', 'true');
        if (outK) outK.textContent = s.dataset.label ?? '';
        if (outB) outB.textContent = s.dataset.body ?? '';
      });
    });
  });
</script>

<style>
  .anat{
    background:var(--term-bg); border-radius:11px; padding:26px 24px 22px;
    margin:0 0 1.6rem; box-shadow:var(--shadow);
  }
  .anat__line{
    font-family:var(--mono); font-size:clamp(.95rem,2.6vw,1.3rem); color:var(--term-ink);
    display:flex; flex-wrap:wrap; align-items:center; justify-content:center; margin-bottom:20px;
  }
  .seg{
    font:inherit; color:var(--term-dim); background:transparent; border:0;
    border-bottom:2px dashed rgba(255,255,255,.22); padding:3px 3px 5px;
    cursor:pointer; transition:color .15s, border-color .15s;
  }
  .seg:hover{color:var(--term-ink); border-bottom-color:var(--term-prompt)}
  .seg[aria-pressed="true"]{
    color:var(--term-prompt); border-bottom-color:var(--term-prompt); border-bottom-style:solid;
  }
  .seg:focus-visible{outline:2px solid var(--term-prompt); outline-offset:3px; border-radius:3px}
  .sep{color:var(--term-cmt); padding:0 1px}
  .anat__out{border-top:1px solid rgba(255,255,255,.1); padding-top:16px; min-height:104px}
  .anat__k{
    font-family:var(--mono); font-size:.7rem; letter-spacing:.13em; text-transform:uppercase;
    color:var(--term-prompt); margin-bottom:7px;
  }
  .anat__x{color:var(--term-ink); font-size:.92rem; line-height:1.75; margin:0; max-width:none}
  .anat__hint{text-align:center; font-size:.76rem; color:var(--term-cmt); margin:14px 0 0; max-width:none}
</style>
